<%- include('../partials/head', {title: 'Mercario — Editar cliente'}) %>
<body><div class="page-shell"><div class="page-container"><main class="page-content">
<%- include('../partials/detail-header', {title: 'Editar cliente', backHref: '/customers/'+customerId, menuHref: null}) %>
<form id="customer-form" class="card-mercario form-card"><div id="loading" class="empty-state p-3">Carregando...</div><div id="fields" style="display:none">
<div class="form-group mb-3"><label class="form-label">Nome completo</label><input id="name" name="name" class="form-control form-control-mercario" required maxlength="150"></div>
<div class="form-group mb-3"><label class="form-label">Apelido <span class="fw-normal text-secondary">(opcional)</span></label><input id="nickname" name="nickname" class="form-control form-control-mercario" maxlength="150"></div>
<div class="form-group mb-3"><label class="form-label">Telefone <span class="fw-normal text-secondary">(opcional)</span></label><input id="phone" name="phone" class="form-control form-control-mercario" maxlength="30"></div>
<div class="form-group mb-3"><label class="form-label">E-mail <span class="fw-normal text-secondary">(opcional)</span></label><input id="email" name="email" type="email" class="form-control form-control-mercario" maxlength="180"></div>
<div class="form-group mb-3"><label class="form-label">Endereço <span class="fw-normal text-secondary">(opcional)</span></label><input id="address" name="address" class="form-control form-control-mercario" maxlength="500"></div>
<div class="form-group mb-3"><label class="form-label">Observações <span class="fw-normal text-secondary">(opcional)</span></label><textarea id="notes" name="notes" class="form-control form-control-mercario" rows="3" maxlength="1000"></textarea></div>
<div id="error" class="error-message"></div><button class="btn-mercario mt-2" type="submit">Salvar alterações</button><button id="delete" type="button" class="btn-danger-mercario mt-2">Excluir cliente</button>
</div></form></main></div></div>
<script>
const id = <%= customerId %>;
const fields = ['name', 'nickname', 'phone', 'email', 'address', 'notes'];
const form = document.getElementById('customer-form');
const error = document.getElementById('error');
const deleteBtn = document.getElementById('delete');

fetch('/api/customers/' + encodeURIComponent(id))
  .then(r => r.ok ? r.json() : r.json().then(e => Promise.reject(new Error(e.message || 'Cliente não encontrado'))))
  .then(c => {
    fields.forEach(k => {
      const el = document.getElementById(k);
      if (el) el.value = c[k] ?? '';
    });
    document.getElementById('loading').style.display = 'none';
    document.getElementById('fields').style.display = 'block';
  })
  .catch(e => {
    document.getElementById('loading').textContent = e.message;
  });

form.addEventListener('submit', async e => {
  e.preventDefault();
  error.style.display = 'none';
  const data = Object.fromEntries(new FormData(form));

  if (!data.name || data.name.trim().length < 2) {
    error.textContent = 'Nome do cliente deve ter pelo menos 2 caracteres';
    error.style.display = 'block';
    return;
  }
  if (data.name.trim().length > 150) {
    error.textContent = 'Nome do cliente muito longo';
    error.style.display = 'block';
    return;
  }
  if (data.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)) {
    error.textContent = 'E-mail inválido';
    error.style.display = 'block';
    return;
  }

  Object.keys(data).forEach(k => {
    if (typeof data[k] === 'string') data[k] = data[k].trim();
    if (data[k] === '') data[k] = null;
  });

  try {
    const r = await fetch('/api/customers/' + encodeURIComponent(id), {
      method: 'PUT',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(data)
    });
    const b = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(b.message || 'Não foi possível salvar.');
    location.href = '/customers/' + id;
  } catch (err) {
    error.textContent = err.message;
    error.style.display = 'block';
  }
});

deleteBtn.onclick = async () => {
  if (!confirm('Excluir este cliente?')) return;
  try {
    const r = await fetch('/api/customers/' + encodeURIComponent(id), {method: 'DELETE'});
    if (r.ok) {
      location.href = '/customers';
    } else {
      const b = await r.json().catch(() => ({}));
      error.textContent = b.message || 'Não foi possível excluir.';
      error.style.display = 'block';
    }
  } catch (err) {
    error.textContent = 'Erro ao conectar ao servidor.';
    error.style.display = 'block';
  }
};
</script></body></html>
