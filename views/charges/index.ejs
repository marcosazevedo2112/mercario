<%- include('../partials/head', {title: 'Mercario — Cobranças'}) %>
<body><div class="page-shell"><div class="page-container"><main class="page-content"><div class="page-header"><h1 class="page-title">Cobranças</h1></div><div id="loading" class="empty-state">Carregando cobranças...</div><div id="list" class="card-mercario list-card"></div><div id="empty" class="empty-state" style="display:none"><strong>Nenhuma cobrança</strong>As parcelas pendentes aparecerão aqui.</div></main><%- include('../partials/bottom-nav',{active:'charges'}) %></div></div>
<script>const brl=v=>Number(v/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});const today=new Date();Promise.all([fetch('/api/sales?limit=50').then(r=>r.json())]).then(async([r])=>{const sales=Array.isArray(r)?r:(r.data||[]);const details=await Promise.all(sales.map(s=>fetch('/api/sales/'+s.id).then(x=>x.ok?x.json():null)));const charges=[];details.filter(Boolean).forEach(s=>(s.installments||[]).forEach(i=>{if(['PENDING'].includes(i.status))charges.push({s,i})}));charges.sort((a,b)=>new Date(a.i.dueDate)-new Date(b.i.dueDate));loading.style.display='none';if(!charges.length){empty.style.display='block';return}list.innerHTML=charges.map(({s,i})=>{const d=new Date(i.dueDate+'T00:00:00');const overdue=d<new Date(today.getFullYear(),today.getMonth(),today.getDate());const cls=overdue?'red':d.toDateString()===today.toDateString()?'orange':'green';return '<a class="charge-row-mercario" href="/charges/'+s.id+'/'+i.id"><span class="charge-dot '+cls+'"></span><div class="charge-info"><p class="charge-name">'+(s.customer?.name||('Cliente #'+s.customerId))+'</p><p class="charge-due">Parcela '+i.number+' · '+d.toLocaleDateString('pt-BR')+'</p></div><span class="charge-value">'+brl(i.amountCents-i.paidAmountCents)+'</span></a>'}).join('')}).catch(e=>{loading.textContent='Não foi possível carregar as cobranças.'});</script></body></html>
