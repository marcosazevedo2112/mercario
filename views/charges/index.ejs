<%- include('../partials/head', {title: 'Mercario — Cobranças'}) %>
<body><div class="page-shell"><div class="page-container"><main class="page-content">
<div class="page-header"><h1 class="page-title">Cobranças</h1></div>
<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-mercario"><%= error %></div>
<% } %>
<% if (typeof charges !== 'undefined' && charges.length > 0) { %>
  <div class="card-mercario list-card">
    <% 
      const today = new Date();
      const brl = v => Number(v / 100).toLocaleString('pt-BR', {style: 'currency', currency: 'BRL'});
      charges.forEach(charge => {
        const d = new Date(charge.dueDate + 'T00:00:00');
        const overdue = d < new Date(today.getFullYear(), today.getMonth(), today.getDate());
        const cls = overdue ? 'red' : (d.toDateString() === today.toDateString() ? 'orange' : 'green');
    %>
    <a class="charge-row-mercario" href="/charges/<%= charge.saleId %>/<%= charge.installmentId %>">
      <span class="charge-dot <%= cls %>"></span>
      <div class="charge-info">
        <p class="charge-name"><%= charge.customerName %></p>
        <p class="charge-due">Parcela <%= charge.number %> · <%= d.toLocaleDateString('pt-BR') %></p>
      </div>
      <span class="charge-value"><%= brl(charge.amountCents) %></span>
    </a>
    <% }); %>
  </div>
<% } else { %>
  <div class="empty-state">
    <strong>Nenhuma cobrança</strong>As parcelas pendentes aparecerão aqui.
  </div>
<% } %>
</main><%- include('../partials/bottom-nav',{active:'charges'}) %></div></div></body></html>
