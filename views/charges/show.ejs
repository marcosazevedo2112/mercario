<%- include('../partials/head', {title: 'Mercario — Cobrança'}) %>
<body>
  <div class="page-shell">
    <div class="page-container">
      <main class="page-content">
        <%- include('../partials/detail-header', {title:'Cobrança', backHref:'/charges', menuHref:null}) %>

        <div id="loading" class="empty-state">Carregando cobrança...</div>
        
        <div id="content" style="display:none">
          
          <div class="card-mercario hero-card">
            <div id="avatar" class="avatar-sm mx-auto mb-2" style="width:48px;height:48px"></div>
            <p id="customer" class="hero-name"></p>
            <p id="amount" class="hero-value"></p>
            <span id="due-badge" class="status-badge status-pending"></span>
          </div>

          <div class="stat-grid-mercario">
            <div class="card-mercario stat-card-mercario">
              <p class="stat-label-mercario">Parcela</p>
              <p id="number" class="stat-value-mercario"></p>
            </div>
            <div class="card-mercario stat-card-mercario">
              <p class="stat-label-mercario">Vencimento</p>
              <p id="due" class="stat-value-mercario"></p>
            </div>
          </div>

          <button id="pay" class="btn-mercario">
            <i class="bi bi-check2-circle"></i> Registrar pagamento
          </button>

          <div class="section-label">Histórico</div>

          <div class="card-mercario p-3">
            <div class="timeline-item">
              <span class="timeline-dot"></span>
              <div>
                <p class="timeline-date" id="created"></p>
                <p class="timeline-text">Parcela criada</p>
              </div>
            </div>

            <div id="paid-line" class="timeline-item" style="display:none">
              <span class="timeline-dot" style="background:var(--green)"></span>
              <div>
                <p class="timeline-date" id="paid-at"></p>
                <p class="timeline-text">Pagamento registrado</p>
              </div>
            </div>
          </div>
          
        </div>

        <div id="error" class="alert alert-mercario" style="display:none"></div>
      </main>
    </div>
  </div>

  <script>
    const saleId = <%= saleId %>;
    const installmentId = <%= installmentId %>;
    
    const brl = v => Number(v / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

    // 1. Mapeamento correto dos elementos do DOM
    const elCustomer = document.getElementById('customer');
    const elAvatar = document.getElementById('avatar');
    const elAmount = document.getElementById('amount');
    const elNumber = document.getElementById('number');
    const elDue = document.getElementById('due');
    const elDueBadge = document.getElementById('due-badge');
    const elCreated = document.getElementById('created');
    const elPaidLine = document.getElementById('paid-line');
    const elPaidAt = document.getElementById('paid-at');
    const elPay = document.getElementById('pay');
    const elLoading = document.getElementById('loading');
    const elContent = document.getElementById('content');
    const elError = document.getElementById('error');

    fetch('/api/sales/' + saleId)
      .then(r => r.json())
      .then(s => {
        console.log(s);
        const i = (s.Saleinstallments || []).find(x => String(x.id) === String(installmentId));
        
        if (!i) throw new Error('Cobrança não encontrada');
        
        const c = s.customer?.name || ('Cliente #' + s.customerId);
        
        elCustomer.textContent = c;
        elAvatar.textContent = c.split(' ').slice(0, 2).map(x => x[0]).join('').toUpperCase();
        elAmount.textContent = brl(i.amountCents - i.paidAmountCents);
        elNumber.textContent = i.number;
        
        const d = new Date(i.dueDate + 'T00:00:00');
        elDue.textContent = d.toLocaleDateString('pt-BR');
        
        const now = new Date();
        const overdue = d < new Date(now.getFullYear(), now.getMonth(), now.getDate());
        
        elDueBadge.textContent = overdue ? 'Vencida' : (d.toDateString() === now.toDateString() ? 'Vence hoje' : 'A vencer');
        elDueBadge.className = 'status-badge ' + (overdue ? 'status-overdue' : 'status-pending');
        
        elCreated.textContent = new Date(i.createdAt).toLocaleDateString('pt-BR');
        
        if (i.paidAt) {
          elPaidLine.style.display = 'flex';
          elPaidAt.textContent = new Date(i.paidAt).toLocaleDateString('pt-BR');
          elPay.style.display = 'none';
        } else {
          elPay.onclick = async () => {
            const r = await fetch('/api/sales/' + saleId + '/installments/' + installmentId + '/payment', { method: 'POST' });
            if (r.ok) {
              location.reload();
            } else {
              elError.textContent = 'Não foi possível registrar o pagamento.';
              elError.style.display = 'block';
            }
          };
        }
        
        elLoading.style.display = 'none';
        elContent.style.display = 'block';
      })
      .catch(e => {
        elLoading.style.display = 'none';
        elError.textContent = e.message;
        elError.style.display = 'block';
      });
  </script>
</body>
</html>