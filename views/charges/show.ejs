<%- include('../partials/head', {title: 'Mercario — Cobrança'}) %>
<body><div class="page-shell"><div class="page-container"><main class="page-content"><%- include('../partials/detail-header', {title:'Cobrança', backHref:'/charges', menuHref:null}) %>
<div id="loading" class="empty-state">Carregando cobrança...</div><div id="content" style="display:none"><div class="card-mercario hero-card"><div id="avatar" class="avatar-sm mx-auto mb-2" style="width:48px;height:48px"></div><p id="customer" class="hero-name"></p><p id="amount" class="hero-value"></p><span id="due-badge" class="status-badge status-pending"></span></div><div class="stat-grid-mercario"><div class="card-mercario stat-card-mercario"><p class="stat-label-mercario">Parcela</p><p id="number" class="stat-value-mercario"></p></div><div class="card-mercario stat-card-mercario"><p class="stat-label-mercario">Vencimento</p><p id="due" class="stat-value-mercario"></p></div></div><button id="pay" class="btn-mercario"><i class="bi bi-check2-circle"></i> Registrar pagamento</button><div class="section-label">Histórico</div><div class="card-mercario p-3"><div class="timeline-item"><span class="timeline-dot"></span><div><p class="timeline-date" id="created"></p><p class="timeline-text">Parcela criada</p></div></div><div id="paid-line" class="timeline-item" style="display:none"><span class="timeline-dot" style="background:var(--green)"></span><div><p class="timeline-date" id="paid-at"></p><p class="timeline-text">Pagamento registrado</p></div></div></div></div><div id="error" class="alert alert-mercario" style="display:none"></div>
</main></div></div><script>const saleId=<%= JSON.stringify(saleId) %>,installmentId=<%= JSON.stringify(installmentId) %>;const brl=v=>Number(v/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});fetch('/api/sales/'+saleId).then(r=>r.json()).then(s=>{const i=(s.installments||[]).find(x=>String(x.id)===String(installmentId));if(!i)throw new Error('Cobrança não encontrada');const c=s.customer?.name||('Cliente #'+s.customerId);customer.textContent=c;avatar.textContent=c.split(' ').slice(0,2).map(x=>x[0]).join('').toUpperCase();amount.textContent=brl(i.amountCents-i.paidAmountCents);number.textContent=i.number;const d=new Date(i.dueDate+'T00:00:00');due.textContent=d.toLocaleDateString('pt-BR');const now=new Date();const overdue=d<new Date(now.getFullYear(),now.getMonth(),now.getDate());dueBadge.textContent=overdue?'Vencida':d.toDateString()===now.toDateString()?'Vence hoje':'A vencer';dueBadge.className='status-badge '+(overdue?'status-overdue':'status-pending');created.textContent=new Date(i.createdAt).toLocaleDateString('pt-BR');if(i.paidAt){paidLine.style.display='flex';paidAt.textContent=new Date(i.paidAt).toLocaleDateString('pt-BR');pay.style.display='none'}else pay.onclick=async()=>{const r=await fetch('/api/sales/'+saleId+'/installments/'+installmentId+'/payment',{method:'POST'});if(r.ok)location.reload();else{error.textContent='Não foi possível registrar o pagamento.';error.style.display='block'}};loading.style.display='none';content.style.display='block'}).catch(e=>{loading.style.display='none';error.textContent=e.message;error.style.display='block'});</script></body></html>
