<%- include('../partials/head', {title: `Mercario — Venda #${sale.id}`}) %>
<body><div class="page-shell"><div class="page-container"><main class="page-content">
<div class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><a href="/sales" class="text-decoration-none small">← Vendas</a><h1 class="page-title mt-2 mb-1">Venda #<%= sale.id %> — <%= sale.customer ? sale.customer.name : 'Cliente não identificado' %></h1><div class="text-muted">Data: <%= new Date(sale.createdAt).toLocaleDateString('pt-BR') %></div></div><div class="text-end"><span class="badge text-bg-<%= sale.status === 'OPEN' ? 'warning' : sale.status === 'COMPLETED' ? 'success' : 'secondary' %>"><%= sale.status === 'OPEN' ? 'Aberta' : sale.status === 'COMPLETED' ? 'Concluída' : 'Cancelada' %></span><% if (sale.status === 'OPEN') { %><a href="/sales/<%= sale.id %>/cancel" class="btn btn-sm btn-outline-danger ms-2">Cancelar venda</a><% } %></div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h6 fw-bold mb-3">Produtos</h2><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Produto</th><th>Qtd.</th><th>Valor unit.</th><th>Subtotal</th></tr></thead><tbody><% (sale.items || []).forEach(item => { %><tr><td><%= item.productName %></td><td><%= item.quantity %></td><td>R$ <%= (item.unitPriceCents / 100).toFixed(2).replace('.', ',') %></td><td>R$ <%= (item.subtotalCents / 100).toFixed(2).replace('.', ',') %></td></tr><% }) %></tbody></table></div></div></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small class="text-muted">Total</small><div class="fs-4 fw-bold">R$ <%= (sale.totalCents / 100).toFixed(2).replace('.', ',') %></div></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small class="text-muted">Forma de pagamento</small><div class="fw-semibold mt-1"><%= sale.paymentMethod %></div></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small class="text-muted">Parcelas</small><div class="fw-semibold mt-1"><%= sale.installments %>x de R$ <%= (sale.totalCents / sale.installments / 100).toFixed(2).replace('.', ',') %></div></div></div></div></div>
<div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h6 fw-bold mb-3">Parcelas</h2><% const installments = sale.Saleinstallments || sale.installmentsList || []; const formatIso = iso => {const [y,m,d]=String(iso).slice(0,10).split('-'); return `${d}/${m}/${y}`;}; %><% if (!installments.length) { %><div class="text-muted">Nenhuma parcela encontrada.</div><% } %><div class="list-group list-group-flush"><% installments.forEach(item => {const due=String(item.dueDate).slice(0,10); const state=item.status==='PENDING'?(due<today?'overdue':due===today?'today':'upcoming'):item.status.toLowerCase(); const badge=state==='overdue'?'danger':state==='today'?'warning':state==='upcoming'?'primary':state==='paid'?'success':state==='settled'?'info':'secondary';%><div class="list-group-item px-0 py-3 installment-row" data-installment-id="<%= item.id %>"><div class="d-flex flex-wrap justify-content-between gap-3 align-items-center"><div><strong>Parcela <%= item.number %>/<%= sale.installments %></strong><div class="small text-muted">Vencimento <%= formatIso(due) %> · R$ <%= (item.amountCents / 100).toFixed(2).replace('.', ',') %></div></div><div class="d-flex align-items-center gap-2"><span class="badge text-bg-<%= badge %>"><%= item.status==='PAID' ? `✓ Pago em ${item.paidAt ? new Date(item.paidAt).toLocaleDateString('pt-BR') : ''}` : item.status==='SETTLED' ? '✓ Quitado' : item.status==='CANCELED' ? '✗ Cancelada' : state==='overdue' ? '🔴 Vencida' : state==='today' ? '🟠 Vence hoje' : `🔵 ${formatIso(due)}` %></span><% if (item.status==='PENDING') { %><button class="btn btn-sm btn-outline-success pay-btn" data-installment-id="<%= item.id %>" data-number="<%= item.number %>/<%= sale.installments %>" data-amount="R$ <%= (item.amountCents / 100).toFixed(2).replace('.', ',') %>" data-due="<%= formatIso(due) %>">Marcar como paga</button><button class="btn btn-sm btn-outline-primary charge-btn" data-installment-id="<%= item.id %>" data-number="<%= item.number %>/<%= sale.installments %>" data-amount="R$ <%= (item.amountCents / 100).toFixed(2).replace('.', ',') %>" data-due="<%= formatIso(due) %>">Enviar cobrança</button><% } %></div></div><div class="charge-history small mt-2" data-history-for="<%= item.id %>"></div></div><% }) %></div></div></div>
<div class="modal fade" id="paymentModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Confirmar pagamento</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p>Parcela <strong id="pNumber"></strong></p><p>Valor: <strong id="pAmount"></strong></p><p>Vencimento: <strong id="pDue"></strong></p></div><div class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-success" id="confirmPayment">Confirmar pagamento</button></div></div></div></div>
<div class="modal fade" id="chargeModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" id="chargeForm"><div class="modal-header"><h5 class="modal-title">Enviar cobrança</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label">Canal</label><div class="d-flex gap-3"><label><input type="radio" name="channel" value="WHATSAPP" checked> WhatsApp</label><label><input type="radio" name="channel" value="SMS"> SMS</label><label><input type="radio" name="channel" value="EMAIL"> E-mail</label></div></div><label class="form-label">Mensagem</label><textarea class="form-control" name="message" rows="4" required></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary">Enviar cobrança</button></div></form></div></div>
</main><%- include('../partials/bottom-nav', {active: 'sales'}) %></div></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script>
(() => {const pm=new bootstrap.Modal('#paymentModal'),cm=new bootstrap.Modal('#chargeModal');let selected=null;document.querySelectorAll('.pay-btn').forEach(b=>b.onclick=()=>{selected=b; pNumber.textContent=b.dataset.number;pAmount.textContent=b.dataset.amount;pDue.textContent=b.dataset.due;pm.show();});confirmPayment.onclick=async()=>{if(!selected)return;confirmPayment.disabled=true;try{const r=await fetch(`/api/sales/<%= sale.id %>/installments/${selected.dataset.installmentId>/payment`,{method:'POST',headers:{Accept:'application/json'}});const d=await r.json();if(!r.ok)throw Error(d.message||'Erro ao registrar pagamento');const row=selected.closest('.installment-row');selected.remove();row.querySelector('.badge').className='badge text-bg-success';row.querySelector('.badge').textContent=`✓ Pago em ${new Date(d.installment.paidAt).toLocaleDateString('pt-BR')}`;pm.hide();}catch(e){alert(e.message)}finally{confirmPayment.disabled=false}};document.querySelectorAll('.charge-btn').forEach(b=>b.onclick=()=>{selected=b;chargeForm.message.value=`Olá, sua parcela de ${b.dataset.amount} vence em ${b.dataset.due}.`;cm.show();});chargeForm.onsubmit=async e=>{e.preventDefault();const body={channel:chargeForm.channel.value,message:chargeForm.message.value};try{const r=await fetch(`/api/sales/<%= sale.id %>/installments/${selected.dataset.installmentId>/charges`,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(body)});const d=await r.json();if(!r.ok)throw Error(d.message||'Erro ao enviar cobrança');cm.hide();loadHistory(selected.dataset.installmentId)}catch(e){alert(e.message)}};async function loadHistory(id){const r=await fetch(`/api/sales/<%= sale.id %>/installments/${id}/charges`);if(!r.ok)return;const d=await r.json();const list=Array.isArray(d)?d:(d.data||[]);const el=document.querySelector(`[data-history-for="${id}"]`);el.innerHTML=list.length?'<strong>Cobranças enviadas:</strong> '+list.map(c=>`<span class="ms-2">• ${new Date(c.createdAt||c.sentAt).toLocaleDateString('pt-BR')} — ${c.channel}</span>`).join(''):'<span class="text-muted">Nenhuma cobrança enviada.</span>';}document.querySelectorAll('[data-history-for]').forEach(el=>loadHistory(el.dataset.historyFor));})();
</script></body></html>
