<%- include('../partials/head', {title: 'Mercario — Venda'}) %>
<body><div class="page-shell"><div class="page-container"><main class="page-content"><%- include('../partials/detail-header', {title:'Venda', backHref:'/sales', menuHref:null}) %>
<div id="loading" class="empty-state">Carregando venda...</div><div id="content" style="display:none"><div class="order-hero"><p id="order-id" class="order-id"></p><p id="total" class="order-total"></p><span id="status" class="order-status"></span></div><div class="card-mercario p-3 mb-3"><div class="section-label mt-0">Cliente</div><p id="customer" class="item-name"></p><p id="date" class="item-sub"></p></div><div class="section-label">Produtos</div><div id="items" class="card-mercario list-card mb-3"></div><div class="card-mercario p-3 mb-3"><div class="summary-row total"><span>Total</span><strong id="total-bottom"></strong></div></div><div class="action-row-mercario"><a id="settle" class="btn-outline-mercario"><i class="bi bi-check2-circle"></i> Quitar</a><a id="cancel" class="btn-danger-mercario"><i class="bi bi-x-circle"></i> Cancelar</a></div></div><div id="error" class="alert alert-mercario" style="display:none"></div></main><%- include('../partials/bottom-nav',{active:'sales'}) %></div></div>
<script>const id = <%= saleId %>;const brl=v=>Number(v/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});const val=(o,...keys)=>keys.reduce((a,k)=>a??o?.[k],null);fetch('/api/sales/'+id).then(r=>r.ok?r.json():Promise.reject(new Error('Venda não encontrada'))).then(s=>{const customerData=val(s,'customer','customerName');const items=val(s,'items','saleItems')||[];const total=val(s,'totalCents','total')??items.reduce((n,i)=>n+(Number(val(i,'unitPriceCents','priceCents')||0)*Number(i.quantity||0)),0);document.getElementById('order-id').textContent='Pedido #'+s.id;document.getElementById('total').textContent=brl(total);document.getElementById('total-bottom').textContent=brl(total);document.getElementById('status').textContent=s.status==='COMPLETED'?'Concluída':s.status==='CANCELED'?'Cancelada':'Aberta';document.getElementById('customer').textContent=(typeof customerData==='object'?customerData?.name:customerData)||('Cliente #'+s.customerId);document.getElementById('date').textContent=new Date(s.createdAt).toLocaleDateString('pt-BR');document.getElementById('items').innerHTML=items.map(i=>'<div class="line-item-mercario"><div class="line-item-top"><div><p class="line-item-name">'+(i.product?.name||'Produto #'+i.productId)+'</p><p class="line-item-meta">'+i.quantity+'x</p></div><span class="price-tag">'+brl((i.unitPriceCents||0)*(i.quantity||0))+'</span></div></div>').join('');document.getElementById('settle').href='/sales/'+id+'/settle';document.getElementById('cancel').href='/sales/'+id+'/cancel';document.getElementById('loading').style.display='none';document.getElementById('content').style.display='block'}).catch(e=>{loading.style.display='none';error.textContent=e.message;error.style.display='block'});</script></body></html>
