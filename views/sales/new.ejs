<%- include('../partials/head', {title: 'Mercario — Nova venda'}) %>
<body><div class="page-shell"><div class="page-container"><main class="page-content"><%- include('../partials/detail-header', {title:'Nova venda', backHref:'/sales', menuHref:null}) %>
<form id="form"><div class="section-label mt-0">Cliente</div><div class="search-box"><i class="bi bi-search"></i><input id="customer-search" type="search" placeholder="Buscar cliente"></div><div id="customers" class="search-results"></div><div id="selected-customer"></div>
<div class="section-label">Produtos</div><div class="search-box"><i class="bi bi-search"></i><input id="product-search" type="search" placeholder="Buscar produto"></div><div id="products" class="search-results"></div><div id="items" class="card-mercario list-card mb-2"></div>
<div class="section-label">Pagamento</div><div class="payment-grid mb-2"><button type="button" class="payment-option selected" data-method="PIX">PIX</button><button type="button" class="payment-option" data-method="BOLETO">Boleto</button><button type="button" class="payment-option" data-method="CREDIT_CARD">Cartão de crédito</button><button type="button" class="payment-option" data-method="DEBIT_CARD">Cartão de débito</button><button type="button" class="payment-option" data-method="CASH">Dinheiro</button></div><div class="row g-2"><div class="col-6"><label class="form-label">Parcelas</label><input id="installments" type="number" min="1" value="1" class="form-control form-control-mercario"></div><div class="col-6"><label class="form-label">Primeiro vencimento</label><input id="due" type="date" class="form-control form-control-mercario"></div></div>
<div class="section-label">Desconto</div><input id="discount" class="form-control form-control-mercario" inputmode="decimal" value="0,00"><div class="section-label">Observações</div><textarea id="notes" class="form-control form-control-mercario" rows="2" maxlength="500"></textarea>
<div class="card-mercario p-3 mt-3"><div class="summary-row"><span>Subtotal</span><strong id="subtotal">R$ 0,00</strong></div><div class="summary-row"><span>Desconto</span><strong id="discount-view">R$ 0,00</strong></div><div class="summary-row total"><span>Total</span><strong id="total">R$ 0,00</strong></div></div><div id="error" class="error-message"></div><button class="btn-mercario mt-3" type="submit">Finalizar venda</button></form>
</main></div></div>
<script>
let customers=[],products=[],selectedCustomer=null,items=[],method='PIX';const brl=v=>Number(v/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});const cents=v=>Math.max(0,Math.round(Number(String(v).replace(/\./g,'').replace(',','.'))*100));const due=document.getElementById('due');due.value=new Date().toISOString().slice(0,10);
Promise.all([fetch('/api/customers').then(r=>r.json()),fetch('/api/products').then(r=>r.json())]).then(([c,p])=>{customers=Array.isArray(c)?c:(c.data||[]);products=Array.isArray(p)?p:(p.data||[])});
function renderCustomers(q=''){document.getElementById('customers').innerHTML=customers.filter(c=>c.name.toLowerCase().includes(q.toLowerCase())).slice(0,5).map(c=>'<div class="search-result"><div><p class="search-result-name">'+c.name+'</p><p class="search-result-meta">'+(c.phone||c.email||'')+'</p></div><button type="button" class="btn-link-mercario" onclick="selectCustomer('+c.id+')">Selecionar</button></div>').join('')}
function selectCustomer(id){selectedCustomer=customers.find(c=>c.id===id);document.getElementById('selected-customer').innerHTML='<div class="card-mercario p-2 mb-2 d-flex justify-content-between align-items-center"><span class="item-name">'+selectedCustomer.name+'</span><button type="button" class="btn-link-mercario" onclick="selectedCustomer=null;renderSelected()">Remover</button></div>';document.getElementById('customers').innerHTML=''}function renderSelected(){document.getElementById('selected-customer').innerHTML=''}
function renderProducts(q=''){document.getElementById('products').innerHTML=products.filter(p=>p.name.toLowerCase().includes(q.toLowerCase())).slice(0,5).map(p=>'<div class="search-result"><div><p class="search-result-name">'+p.name+'</p><p class="search-result-meta">Venda '+brl(p.priceCents)+'</p></div><button type="button" class="btn-link-mercario" onclick="addProduct('+p.id+')">Adicionar</button></div>').join('')}
function addProduct(id){const p=products.find(x=>x.id===id),i=items.find(x=>x.productId===id);if(i)i.quantity++;else items.push({productId:id,quantity:1,product:p});renderItems()};function renderItems(){itemsEl.innerHTML=items.map((i,n)=>'<div class="line-item-mercario"><div class="line-item-top"><div><p class="line-item-name">'+i.product.name+'</p><p class="line-item-meta">'+brl(i.product.priceCents)+' por unidade</p></div><button type="button" class="btn-link-mercario" onclick="items.splice('+n+',1);renderItems()">Remover</button></div><div class="line-item-bottom"><div class="stepper"><button type="button" onclick="i.quantity=Math.max(1,i.quantity-1);renderItems()">−</button><span class="stepper-value">'+i.quantity+'</span><button type="button" onclick="i.quantity++;renderItems()">+</button></div><span class="price-tag">'+brl(i.product.priceCents*i.quantity)+'</span></div></div>').join('');updateTotal()};function updateTotal(){const sub=items.reduce((n,i)=>n+i.product.priceCents*i.quantity,0),d=cents(discount.value);subtotal.textContent=brl(sub);discountView.textContent=brl(d);total.textContent=brl(Math.max(0,sub-d))}
const itemsEl=document.getElementById('items');customerSearch.oninput=e=>renderCustomers(e.target.value);productSearch.oninput=e=>renderProducts(e.target.value);discount.oninput=updateTotal;document.querySelectorAll('.payment-option').forEach(b=>b.onclick=()=>{document.querySelectorAll('.payment-option').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');method=b.dataset.method});renderCustomers();renderProducts();
form.onsubmit=async e=>{e.preventDefault();if(!selectedCustomer)return showError('Selecione um cliente.');if(!items.length)return showError('Adicione ao menos um produto.');const data={customerId:selectedCustomer.id,items:items.map(i=>({productId:i.productId,quantity:i.quantity})),discountCents:cents(discount.value),paymentPlan:{paymentMethod:method,installments:Number(installments.value),initialDueDate:new Date(due.value+'T00:00:00').toISOString(),modality:Number(installments.value)>1?'MONTHLY':'ONCE'},notes:notes.value||undefined};try{const r=await fetch('/api/sales',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const b=await r.json().catch(()=>({}));if(!r.ok)throw new Error(b.message||'Não foi possível criar a venda.');location.href='/sales/'+b.id}catch(err){showError(err.message)}};function showError(m){error.textContent=m;error.style.display='block'}
</script></body></html>
