<%- include('../partials/head', {title: 'Mercario — Vendas'}) %>
<body id="pagina__vendas"><div class="page-shell"><div class="page-container"><main class="page-content">
<div class="page-header"><h1 class="page-title">Vendas <span class="page-count">(<%= pagination ? pagination.total : 0 %>)</span></h1><a href="/sales/new" class="icon-button" aria-label="Nova venda"><i class="bi bi-plus-lg"></i></a></div>

<% if (error) { %><div class="alert alert-danger py-2 small"><%= error %></div><% } %>

<%
  const fmtBRL = (cents) => Number(cents / 100).toLocaleString('pt-BR', {style:'currency', currency:'BRL'});
  const monthNames = ['JANEIRO','FEVEREIRO','MARÇO','ABRIL','MAIO','JUNHO','JULHO','AGOSTO','SETEMBRO','OUTUBRO','NOVEMBRO','DEZEMBRO'];
  function formatGroupDate(iso) {
    if (!iso) return '';
    const parts = iso.slice(0,10).split('-');
    const y = Number(parts[0]), m = Number(parts[1]), d = Number(parts[2]);
    if (!y || !m || !d) return iso;
    return d + ' DE ' + (monthNames[m-1] || '');
  }
  function dueDateLabel(iso, todayStr) {
    if (iso === todayStr) return ' — HOJE';
    if (iso < todayStr) return ' — VENCIDA';
    return '';
  }
  function dueDateFormatted(iso) {
    if (!iso) return '';
    const p = iso.slice(0,10).split('-');
    return p[2] + '/' + p[1] + '/' + p[0];
  }
  const safeSummary = typeof summary !== 'undefined' && summary ? summary : {overdueTotal:0, todayTotal:0, upcomingTotal:0};
  const safeGrouped = typeof grouped !== 'undefined' && grouped ? grouped : {};
  const safeSearch = typeof search !== 'undefined' ? search : '';
  const safeStatus = typeof status !== 'undefined' ? status : '';
  const safeToday = typeof today !== 'undefined' ? today : new Date().toISOString().slice(0,10);
  const groupedKeys = Object.keys(safeGrouped).sort();
  // Build pending count per sale from sales array (Saleinstallments)
  const pendingCountBySale = {};
  if (typeof sales !== 'undefined' && sales) {
    sales.forEach(s => {
      const arr = s.Saleinstallments || s.installments || [];
      const pending = arr.filter(i => i.status === 'PENDING').length;
      pendingCountBySale[s.id] = pending;
    });
  }
  // Also count from grouped if sale not in current page
  groupedKeys.forEach(k => {
    (safeGrouped[k]||[]).forEach(item => {
      const inst = item.installment || item;
      const saleId = inst.saleId || (inst.sale && inst.sale.id);
      if (saleId && pendingCountBySale[saleId] === undefined) {
        // fallback: count occurrences in grouped
        let cnt = 0;
        groupedKeys.forEach(k2 => (safeGrouped[k2]||[]).forEach(it => {
          const ii = it.installment || it;
          const sid = ii.saleId || (ii.sale && ii.sale.id);
          if (sid === saleId) cnt++;
        }));
        pendingCountBySale[saleId] = cnt;
      }
    });
  });
  // Pagination helpers
  const curPage = pagination ? pagination.page : 1;
  const totalPages = pagination ? pagination.totalPages : 1;
  function pageHref(p) {
    const params = new URLSearchParams();
    if (safeSearch) params.set('search', safeSearch);
    if (safeStatus) params.set('status', safeStatus);
    params.set('page', String(p));
    params.set('limit', String(pagination ? pagination.limit : 20));
    return '/sales?' + params.toString();
  }
  const filterTabs = [
    {key:'', label:'Todas'},
    {key:'today', label:'Hoje'},
    {key:'overdue', label:'Vencidas'},
    {key:'upcoming', label:'Próximas'},
  ];
%>

<!-- Summary cards -->
<div class="row g-2 mb-3">
  <div class="col-4"><div class="card-mercario p-2 text-center"><p class="mini-label mb-1">A receber hoje</p><p class="mini-value" style="color:var(--amber);font-size:13px;"><%= fmtBRL(safeSummary.todayTotal) %></p></div></div>
  <div class="col-4"><div class="card-mercario p-2 text-center"><p class="mini-label mb-1">Vencido</p><p class="mini-value" style="color:var(--red);font-size:13px;"><%= fmtBRL(safeSummary.overdueTotal) %></p></div></div>
  <div class="col-4"><div class="card-mercario p-2 text-center"><p class="mini-label mb-1">Próximos 7 dias</p><p class="mini-value" style="color:var(--blue);font-size:13px;"><%= fmtBRL(safeSummary.upcomingTotal) %></p></div></div>
</div>

<!-- Search -->
<form method="GET" action="/sales" class="search-box mb-3" style="display:flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--gray-100);border-radius:10px;padding:8px 12px;">
  <i class="bi bi-search" aria-hidden="true" style="color:var(--text-secondary);"></i>
  <input type="search" name="search" value="<%= safeSearch %>" placeholder="Pesquisar venda" aria-label="Pesquisar venda" style="flex:1;border:0;outline:0;font-size:13px;">
  <% if (safeStatus) { %><input type="hidden" name="status" value="<%= safeStatus %>"><% } %>
  <button type="submit" class="btn-link-mercario" style="white-space:nowrap;">Buscar</button>
</form>

<!-- Filter tabs -->
<div class="d-flex gap-2 mb-3" id="filter-tabs" role="tablist" style="overflow-x:auto;flex-wrap:nowrap;">
  <% filterTabs.forEach(tab => { %>
    <button type="button" data-filter="<%= tab.key %>" class="filter-tab btn btn-sm <%= safeStatus === tab.key || (!safeStatus && tab.key==='') ? 'btn-primary' : 'btn-outline-secondary' %>" style="border-radius:20px;font-size:11px;white-space:nowrap;font-weight:600;"><%= tab.label %></button>
  <% }) %>
</div>

<!-- Receivables agenda -->
<div id="agenda" class="mb-3">
  <% if (!groupedKeys.length) { %>
    <div class="card-mercario p-3 text-center"><p class="confirm-text mb-0">Nenhuma parcela pendente no período.</p></div>
  <% } else { %>
    <% groupedKeys.forEach(iso => {
         const items = safeGrouped[iso] || [];
         // Filter check is done client-side, but we render all; tabs hide
    %>
      <div class="agenda-group mb-3" data-date="<%= iso %>">
        <div class="d-flex align-items-center gap-2 mb-2" style="font-size:11px;font-weight:700;letter-spacing:.04em;color:var(--text-secondary);">
          <span><%= formatGroupDate(iso) %><%= dueDateLabel(iso, safeToday) %></span>
          <span style="flex:1;height:1px;background:var(--gray-100);"></span>
          <span style="font-weight:500;"><%= items.length %> parcela<%= items.length!==1?'s':'' %></span>
        </div>
        <% items.forEach(entry => {
             const inst = entry.installment || entry;
             const overdueStatus = entry.overdueStatus || (iso < safeToday ? 'overdue' : iso === safeToday ? 'today' : 'upcoming');
             const sale = inst.sale || null;
             const customerName = (sale && sale.customer && sale.customer.name) ? sale.customer.name : (sale ? ('Cliente #' + sale.customerId) : ('Venda #' + (inst.saleId||'')));
             const totalInst = sale ? (sale.installments || 0) : 0;
             const amount = fmtBRL(inst.amountCents || 0);
             const dueFmt = dueDateFormatted(iso);
             let badgeClass = 'bg-primary', dotColor = 'var(--blue)';
             if (overdueStatus === 'overdue') { badgeClass = 'bg-danger'; dotColor = 'var(--red)'; }
             else if (overdueStatus === 'today') { badgeClass = 'bg-warning text-dark'; dotColor = 'var(--amber)'; }
             const saleId = inst.saleId || (sale && sale.id);
             const instId = inst.id;
             const pendingCount = pendingCountBySale[saleId] || 1;
        %>
          <div class="card-mercario p-2 mb-2 agenda-item" data-status="<%= overdueStatus %>" data-sale-id="<%= saleId %>" data-installment-id="<%= instId %>" style="display:flex;align-items:center;gap:10px;">
            <span style="width:10px;height:10px;border-radius:50%;flex:0 0 10px;background:<%= dotColor %>;display:inline-block;"></span>
            <div style="flex:1;min-width:0;">
              <p class="mb-0" style="font-size:12px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= customerName %> — Parcela <%= inst.number %>/<%= totalInst || '?' %> — <%= amount %></p>
              <p class="mb-0" style="font-size:10px;color:var(--text-secondary);">Vencimento: <%= dueFmt %> <span class="badge <%= badgeClass %>" style="font-size:9px;vertical-align:middle;"><% if (overdueStatus==='overdue'){ %>Vencida<% } else if (overdueStatus==='today'){ %>Vence hoje<% } else { %>Próxima<% } %></span></p>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary pay-btn" style="font-size:11px;white-space:nowrap;font-weight:600;"
              data-sale-id="<%= saleId %>"
              data-installment-id="<%= instId %>"
              data-customer="<%= customerName.replace(/"/g,'&quot;') %>"
              data-number="<%= inst.number %>"
              data-total="<%= totalInst %>"
              data-amount="<%= amount %>"
              data-due="<%= dueFmt %>"
              data-iso="<%= iso %>"
              data-pending="<%= pendingCount %>">Marcar como paga</button>
          </div>
        <% }) %>
      </div>
    <% }) %>
  <% } %>
</div>

<!-- Sales list -->
<div class="card-mercario list-card mb-3">
  <div class="p-2" style="font-size:11px;font-weight:700;color:var(--text-secondary);border-bottom:1px solid var(--gray-100);">Vendas recentes</div>
  <% if (!sales.length) { %><div class="empty-state p-3 text-center"><strong>Nenhuma venda encontrada</strong><p class="confirm-text">Quando você registrar uma venda, ela aparecerá aqui.</p></div><% } %>
  <% sales.forEach(sale => {
       const customerName = sale.customer ? sale.customer.name : (sale.customerName || 'Cliente não identificado');
       const displayName = typeof customerName === 'object' ? (customerName.name || 'Cliente') : customerName;
       const parts = String(displayName).split(' ').slice(0,2);
       const initials = parts.map(part => part.charAt(0)).join('').toUpperCase();
       const total = (sale.totalCents / 100).toFixed(2).replace('.', ',');
       const statusClass = sale.status === 'OPEN' ? 'status-open' : sale.status === 'COMPLETED' ? 'status-completed' : 'status-canceled';
       const statusLabel = sale.status === 'OPEN' ? 'Aberta' : sale.status === 'COMPLETED' ? 'Concluída' : 'Cancelada';
  %>
    <a href="/sales/<%= sale.id %>" class="sale-row" style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;border-bottom:1px solid #f0f0f0;text-decoration:none;color:inherit;">
      <div class="sale-left" style="display:flex;align-items:center;gap:10px;min-width:0;">
        <div class="avatar-sm" style="width:32px;height:32px;border-radius:50%;background:var(--blue-tint);color:var(--blue);display:flex;align-items:center;justify-content:center;font:700 11px 'Rubik',sans-serif;flex:0 0 32px;"><%= initials %></div>
        <div style="min-width:0;"><p class="sale-name" style="margin:0;font-size:12px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= displayName %></p><p class="sale-meta" style="margin:2px 0 0;font-size:10px;color:var(--text-secondary);"><%= sale.items ? sale.items.length : (sale.Saleinstallments ? sale.Saleinstallments.length : 0) %><% if (sale.items || sale.Saleinstallments) { %> itens · <% } %><span class="status-badge <%= statusClass %>" style="padding:2px 6px;border-radius:20px;font-size:9px;font-weight:700;background:<%= sale.status==='OPEN'?'#fff0d6':sale.status==='COMPLETED'?'#e3f5ee':'#fbe5e5' %>;color:<%= sale.status==='OPEN'?'var(--amber)':sale.status==='COMPLETED'?'var(--green)':'var(--red)' %>;"><%= statusLabel %></span></p></div>
      </div>
      <div class="sale-right" style="text-align:right;flex:0 0 auto;"><div class="sale-value" style="font:600 12px 'Rubik',sans-serif;color:var(--blue);">R$ <%= total %></div><div class="sale-time" style="font-size:10px;color:var(--text-secondary);"><%= new Date(sale.createdAt).toLocaleDateString('pt-BR') %></div></div>
    </a>
  <% }) %>
</div>

<!-- Pagination -->
<% if (pagination && pagination.totalPages > 1) { %>
  <nav class="d-flex align-items-center justify-content-between mb-3" aria-label="Paginação">
    <% if (curPage > 1) { %><a href="<%= pageHref(curPage-1) %>" class="btn btn-sm btn-outline-secondary" style="font-size:11px;">← Anterior</a><% } else { %><span class="btn btn-sm btn-outline-secondary disabled" style="font-size:11px;opacity:.5;">← Anterior</span><% } %>
    <span style="font-size:11px;color:var(--text-secondary);">Página <%= curPage %> de <%= totalPages %></span>
    <% if (curPage < totalPages) { %><a href="<%= pageHref(curPage+1) %>" class="btn btn-sm btn-outline-secondary" style="font-size:11px;">Próxima →</a><% } else { %><span class="btn btn-sm btn-outline-secondary disabled" style="font-size:11px;opacity:.5;">Próxima →</span><% } %>
  </nav>
<% } %>

</main><%- include('../partials/bottom-nav',{active:'sales'}) %></div></div>

<!-- Payment confirmation modal -->
<div id="payment-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1050;align-items:center;justify-content:center;padding:16px;">
  <div class="card-mercario" style="width:100%;max-width:400px;padding:20px;">
    <h5 style="font:600 15px 'Rubik',sans-serif;margin:0 0 12px;">Confirmar pagamento</h5>
    <div style="font-size:12px;line-height:1.6;">
      <p class="mb-1"><strong>Cliente:</strong> <span id="pm-customer"></span></p>
      <p class="mb-1"><strong>Parcela:</strong> <span id="pm-installment"></span></p>
      <p class="mb-1"><strong>Valor:</strong> <span id="pm-amount"></span></p>
      <p class="mb-1"><strong>Vencimento:</strong> <span id="pm-due"></span></p>
    </div>
    <div id="pm-warning" style="display:none;margin-top:10px;padding:8px 10px;border-radius:8px;background:#fff8e1;border:1px solid #ffe082;font-size:11px;color:#8d6e00;">⚠️ Esta é a última parcela pendente. A venda será concluída automaticamente.</div>
    <div id="pm-error" style="display:none;margin-top:10px;color:var(--red);font-size:11px;"></div>
    <div class="d-flex gap-2 mt-3">
      <button type="button" id="pm-cancel" class="btn btn-outline-secondary flex-fill" style="font-size:12px;font-weight:600;">Cancelar</button>
      <button type="button" id="pm-confirm" class="btn flex-fill" style="background:var(--blue);color:#fff;font-size:12px;font-weight:600;">Confirmar pagamento</button>
    </div>
  </div>
</div>

<!-- Toast -->
<div id="toast-container" style="position:fixed;bottom:80px;left:50%;transform:translateX(-50%);z-index:1060;display:none;">
  <div class="card-mercario" style="padding:10px 18px;background:var(--green);color:#fff;font-size:12px;font-weight:600;box-shadow:0 4px 12px rgba(0,0,0,.15);">Venda concluída ✓</div>
</div>

<script>
(function(){
  const tabs = document.querySelectorAll('.filter-tab');
  const groups = document.querySelectorAll('.agenda-group');
  const items = document.querySelectorAll('.agenda-item');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => { t.classList.remove('btn-primary'); t.classList.add('btn-outline-secondary'); });
      tab.classList.remove('btn-outline-secondary'); tab.classList.add('btn-primary');
      const f = tab.dataset.filter;
      if (!f) {
        groups.forEach(g => g.style.display = '');
        items.forEach(i => i.style.display = '');
      } else if (f === 'today') {
        items.forEach(i => i.style.display = i.dataset.status === 'today' ? '' : 'none');
        groups.forEach(g => {
          const vis = g.querySelectorAll('.agenda-item:not([style*="display: none"])').length;
          g.style.display = vis ? '' : 'none';
        });
      } else if (f === 'overdue') {
        items.forEach(i => i.style.display = i.dataset.status === 'overdue' ? '' : 'none');
        groups.forEach(g => {
          const vis = g.querySelectorAll('.agenda-item:not([style*="display: none"])').length;
          g.style.display = vis ? '' : 'none';
        });
      } else if (f === 'upcoming') {
        items.forEach(i => i.style.display = i.dataset.status === 'upcoming' ? '' : 'none');
        groups.forEach(g => {
          const vis = g.querySelectorAll('.agenda-item:not([style*="display: none"])').length;
          g.style.display = vis ? '' : 'none';
        });
      }
      // Update URL without reload for shareability
      const url = new URL(window.location.href);
      if (f) url.searchParams.set('status', f);
      else url.searchParams.delete('status');
      history.replaceState(null,'', url.toString());
    });
  });

  // Payment modal logic
  const modal = document.getElementById('payment-modal');
  const pmCustomer = document.getElementById('pm-customer');
  const pmInstallment = document.getElementById('pm-installment');
  const pmAmount = document.getElementById('pm-amount');
  const pmDue = document.getElementById('pm-due');
  const pmWarning = document.getElementById('pm-warning');
  const pmError = document.getElementById('pm-error');
  const pmCancel = document.getElementById('pm-cancel');
  const pmConfirm = document.getElementById('pm-confirm');
  let pendingPayBtn = null;
  let pendingSaleId = null;
  let pendingInstId = null;

  function openModal(btn){
    pendingPayBtn = btn;
    pendingSaleId = btn.dataset.saleId;
    pendingInstId = btn.dataset.installmentId;
    pmCustomer.textContent = btn.dataset.customer || '';
    pmInstallment.textContent = (btn.dataset.number || '?') + '/' + (btn.dataset.total || '?');
    pmAmount.textContent = btn.dataset.amount || '';
    pmDue.textContent = btn.dataset.due || '';
    const isLast = Number(btn.dataset.pending) === 1;
    pmWarning.style.display = isLast ? 'block' : 'none';
    pmError.style.display = 'none';
    pmError.textContent = '';
    pmConfirm.disabled = false;
    pmConfirm.textContent = 'Confirmar pagamento';
    modal.style.display = 'flex';
  }
  function closeModal(){
    modal.style.display = 'none';
    pendingPayBtn = null;
  }
  document.querySelectorAll('.pay-btn').forEach(btn => {
    btn.addEventListener('click', () => openModal(btn));
  });
  pmCancel.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

  pmConfirm.addEventListener('click', async () => {
    if (!pendingSaleId || !pendingInstId) return;
    pmConfirm.disabled = true;
    pmConfirm.textContent = 'Processando...';
    pmError.style.display = 'none';
    try {
      const res = await fetch('/api/sales/' + pendingSaleId + '/installments/' + pendingInstId + '/payment', {method:'POST', headers:{'Content-Type':'application/json'}});
      const data = await res.json().catch(()=>({}));
      if (!res.ok) throw new Error(data.message || 'Não foi possível registrar o pagamento.');
      // Update row in-place
      if (pendingPayBtn) {
        const row = pendingPayBtn.closest('.agenda-item');
        if (row) {
          pendingPayBtn.remove();
          const paidAt = data.installment && data.installment.paidAt ? new Date(data.installment.paidAt).toLocaleDateString('pt-BR') : new Date().toLocaleDateString('pt-BR');
          const badge = document.createElement('span');
          badge.className = 'badge bg-success';
          badge.style.fontSize = '10px';
          badge.textContent = '✓ Pago em ' + paidAt;
          row.appendChild(badge);
          row.style.opacity = '.85';
        }
      }
      closeModal();
      if (data.saleCompleted) {
        const toast = document.getElementById('toast-container');
        toast.style.display = 'block';
        setTimeout(()=> toast.style.display='none', 3000);
      }
    } catch(err){
      pmError.textContent = err.message || 'Erro ao registrar pagamento.';
      pmError.style.display = 'block';
      pmConfirm.disabled = false;
      pmConfirm.textContent = 'Confirmar pagamento';
    }
  });
})();
</script>
</body></html>
