<%- include('../partials/head', {title: 'Mercario — Vendas'}) %>
<body id="pagina__vendas">
<div class="page-shell"><div class="page-container"><main class="page-content">
<div class="page-header d-flex justify-content-between align-items-center"><div><h1 class="page-title mb-1">Recebimentos</h1><p class="text-muted mb-0">Acompanhe suas parcelas por vencimento.</p></div></div>
<% if (error) { %><div class="alert alert-danger mt-3"><%= error %></div><% } %>
<div class="row g-3 mt-1">
  <div class="col-12 col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small class="text-muted">A receber hoje</small><div class="fs-4 fw-semibold text-warning">R$ <%= (receivableSummary.todayTotal / 100).toFixed(2).replace('.', ',') %></div></div></div></div>
  <div class="col-12 col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small class="text-muted">Vencido</small><div class="fs-4 fw-semibold text-danger">R$ <%= (receivableSummary.overdueTotal / 100).toFixed(2).replace('.', ',') %></div></div></div></div>
  <div class="col-12 col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small class="text-muted">Próximos 7 dias</small><div class="fs-4 fw-semibold text-primary">R$ <%= (receivableSummary.upcomingTotal / 100).toFixed(2).replace('.', ',') %></div></div></div></div>
</div>
<form class="search-box mt-4" method="get" action="/sales"><i class="bi bi-search" aria-hidden="true"></i><input name="search" value="<%= search %>" type="search" placeholder="Pesquisar venda por número" aria-label="Pesquisar venda"><input type="hidden" name="from" value="<%= from %>"><input type="hidden" name="to" value="<%= to %>"><button class="btn btn-sm btn-dark" type="submit">Pesquisar</button></form>
<div class="d-flex gap-2 flex-wrap mt-3" role="tablist">
  <button class="btn btn-sm btn-dark agenda-filter active" data-filter="all">Todas</button><button class="btn btn-sm btn-outline-warning agenda-filter" data-filter="today">Hoje</button><button class="btn btn-sm btn-outline-danger agenda-filter" data-filter="overdue">Vencidas</button><button class="btn btn-sm btn-outline-primary agenda-filter" data-filter="upcoming">Próximas</button>
</div>
<div id="agenda" class="mt-4">
<% const monthNames = ['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro']; const formatIso = iso => {const [y,m,d] = iso.split('-'); return `${d}/${m}/${y}`;}; const formatHeading = iso => {const [y,m,d] = iso.split('-'); return `${d} DE ${monthNames[Number(m)-1].toUpperCase()}`;}; const keys = Object.keys(groupedReceivables).sort(); %>
<% if (!keys.length) { %><div class="card border-0 shadow-sm"><div class="card-body text-center text-muted py-5">Nenhuma parcela pendente no período.</div></div><% } %>
<% keys.forEach(date => { const items = groupedReceivables[date]; const firstStatus = items[0].overdueStatus; %>
<section class="agenda-day mb-4" data-day-statuses="<%= [...new Set(items.map(i => i.overdueStatus))].join(' ') %>"><div class="d-flex align-items-center gap-2 mb-2"><h2 class="h6 fw-bold mb-0"><%= formatHeading(date) %></h2><% if (date === today) { %><span class="badge text-bg-warning">HOJE</span><% } %></div>
<div class="card border-0 shadow-sm overflow-hidden">
<% items.forEach(item => { const sale = item.sale; const customer = sale && sale.customer ? sale.customer.name : 'Cliente não identificado'; const totalPending = sale && sale.Saleinstallments ? sale.Saleinstallments.filter(i => i.status === 'PENDING').length : 2; const statusClass = item.overdueStatus === 'overdue' ? 'danger' : item.overdueStatus === 'today' ? 'warning' : 'primary'; %>
<div class="receivable-row border-start border-4 border-<%= statusClass %> p-3 d-flex flex-wrap align-items-center justify-content-between gap-3" data-status="<%= item.overdueStatus %>" data-installment-id="<%= item.id %>" data-sale-id="<%= sale.id %>">
<div><a class="fw-semibold text-decoration-none" href="/sales/<%= sale.id %>"><%= customer %></a><div class="small text-muted">Parcela <%= item.number %>/<%= sale.installments %> · Vencimento <%= formatIso(date) %></div></div>
<div class="d-flex align-items-center gap-3"><strong>R$ <%= (item.amountCents / 100).toFixed(2).replace('.', ',') %></strong><button class="btn btn-sm btn-outline-success pay-btn" data-customer="<%= customer %>" data-number="<%= item.number %>/<%= sale.installments %>" data-amount="R$ ${(item.amountCents / 100).toFixed(2).replace('.', ',')}" data-due="<%= formatIso(date) %>" data-installment-id="<%= item.id %>" data-sale-id="<%= sale.id %>" data-last="<%= totalPending === 1 %>">Marcar como paga</button></div>
</div>
<% }) %></div></section><% }) %>
</div>
<% if (pagination && pagination.totalPages > 1) { %><nav class="d-flex justify-content-center align-items-center gap-3 my-4" aria-label="Paginação"><% if (pagination.page > 1) { %><a class="btn btn-sm btn-outline-secondary" href="?page=<%= pagination.page - 1 %>&limit=<%= pagination.limit %>&search=<%= encodeURIComponent(search) %>">← Anterior</a><% } %><span class="small text-muted">Página <%= pagination.page %> de <%= pagination.totalPages %></span><% if (pagination.page < pagination.totalPages) { %><a class="btn btn-sm btn-outline-secondary" href="?page=<%= pagination.page + 1 %>&limit=<%= pagination.limit %>&search=<%= encodeURIComponent(search) %>">Próxima →</a><% } %></nav><% } %>
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Confirmar pagamento</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body"><dl class="row mb-0"><dt class="col-5">Cliente</dt><dd class="col-7" id="paymentCustomer"></dd><dt class="col-5">Parcela</dt><dd class="col-7" id="paymentNumber"></dd><dt class="col-5">Valor</dt><dd class="col-7" id="paymentAmount"></dd><dt class="col-5">Vencimento</dt><dd class="col-7" id="paymentDue"></dd></dl><div id="lastWarning" class="alert alert-warning mt-3 d-none">⚠️ Esta é a última parcela pendente. A venda será concluída automaticamente.</div></div><div class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-success" id="confirmPayment">Confirmar pagamento</button></div></div></div></div>
<div class="toast-container position-fixed bottom-0 end-0 p-3"><div id="saleToast" class="toast" role="alert"><div class="toast-header"><strong class="me-auto">Mercario</strong><button class="btn-close" data-bs-dismiss="toast"></button></div><div class="toast-body">Venda concluída ✓</div></div></div>
</main><%- include('../partials/bottom-nav', {active: 'sales'}) %></div></div>
<script>
(() => { const modalEl=document.getElementById('paymentModal'); const modal=new bootstrap.Modal(modalEl); let selected=null; document.querySelectorAll('.agenda-filter').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.agenda-filter').forEach(b=>b.classList.remove('active'));btn.classList.add('active');const f=btn.dataset.filter;document.querySelectorAll('.agenda-day').forEach(day=>day.classList.toggle('d-none',f!=='all'&&!day.dataset.dayStatuses.split(' ').includes(f)));}));
 document.querySelectorAll('.pay-btn').forEach(btn=>btn.addEventListener('click',()=>{selected=btn;paymentCustomer.textContent=btn.dataset.customer;paymentNumber.textContent=btn.dataset.number;paymentAmount.textContent=btn.dataset.amount;paymentDue.textContent=btn.dataset.due;lastWarning.classList.toggle('d-none',btn.dataset.last!=='true');modal.show();}));
 confirmPayment.addEventListener('click',async()=>{if(!selected)return;confirmPayment.disabled=true;try{const r=await fetch(`/api/sales/${selected.dataset.saleId}/installments/${selected.dataset.installmentId}/payment`,{method:'POST',headers:{Accept:'application/json'}});const data=await r.json();if(!r.ok)throw new Error(data.message||'Não foi possível registrar o pagamento');const row=document.querySelector(`.receivable-row[data-installment-id="${selected.dataset.installmentId}"]`);row.classList.remove('border-danger','border-warning','border-primary');row.classList.add('border-success');row.querySelector('.pay-btn').outerHTML=`<span class="badge text-bg-success">✓ Pago em ${new Date(data.installment.paidAt).toLocaleDateString('pt-BR')}</span>`;modal.hide();if(data.saleCompleted)new bootstrap.Toast(document.getElementById('saleToast')).show();}catch(e){alert(e.message);}finally{confirmPayment.disabled=false;}});
})();
</script>
</body></html>
