<%- include('../partials/head', {title: 'Mercario — Vendas'}) %>
<body id="pagina__vendas"><div class="page-shell"><div class="page-container"><main class="page-content">
<div class="page-header"><h1 class="page-title mb-1">Recebimentos</h1><p class="text-muted">Acompanhe suas parcelas por vencimento.</p></div><% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %>
<div class="row g-3"><% [['A receber hoje',receivableSummary.todayTotal,'warning'],['Vencido',receivableSummary.overdueTotal,'danger'],['Próximos 7 dias',receivableSummary.upcomingTotal,'primary']].forEach(card=>{ %><div class="col-12 col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted"><%= card[0] %></small><div class="fs-4 fw-semibold text-<%= card[2] %>">R$ <%= (card[1]/100).toFixed(2).replace('.',',') %></div></div></div></div><% }) %></div>
<form class="search-box mt-4" method="get" action="/sales"><i class="bi bi-search"></i><input name="search" value="<%= search %>" type="search" placeholder="Pesquisar venda por número"><input type="hidden" name="from" value="<%= from %>"><input type="hidden" name="to" value="<%= to %>"><button class="btn btn-sm btn-dark">Pesquisar</button></form>
<div class="d-flex gap-2 flex-wrap mt-3"><button class="btn btn-sm btn-dark agenda-filter active" data-filter="all">Todas</button><button class="btn btn-sm btn-outline-warning agenda-filter" data-filter="today">Hoje</button><button class="btn btn-sm btn-outline-danger agenda-filter" data-filter="overdue">Vencidas</button><button class="btn btn-sm btn-outline-primary agenda-filter" data-filter="upcoming">Próximas</button></div>
<% const months=['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro']; const isoDate=iso=>{const [y,m,d]=String(iso).slice(0,10).split('-');return `${d}/${m}/${y}`}; const dates=Object.keys(groupedReceivables).sort(); %><div class="mt-4">
<% if(!dates.length){ %><div class="card border-0 shadow-sm"><div class="card-body text-center text-muted py-5">Nenhuma parcela pendente no período.</div></div><% } %>
<% dates.forEach(date=>{const items=groupedReceivables[date]; %><section class="agenda-day mb-4" data-day-statuses="<%= [...new Set(items.map(i=>i.overdueStatus))].join(' ') %>"><div class="d-flex align-items-center gap-2 mb-2"><h2 class="h6 fw-bold mb-0"><%= date.split('-')[2] %> DE <%= months[Number(date.split('-')[1])-1].toUpperCase() %></h2><% if(date===today){ %><span class="badge text-bg-warning">HOJE</span><% } %></div><div class="card border-0 shadow-sm overflow-hidden"><% items.forEach(item=>{const sale=item.sale;const customer=sale?.customer?.name||'Cliente não identificado';const statusClass=item.overdueStatus==='overdue'?'danger':item.overdueStatus==='today'?'warning':'primary';const pending=(sale?.Saleinstallments||[]).filter(i=>i.status==='PENDING').length;%><div class="receivable-row border-start border-4 border-<%= statusClass %> p-3 d-flex flex-wrap justify-content-between align-items-center gap-3" data-installment-id="<%= item.id %>" data-sale-id="<%= sale.id %>"><div><a href="/sales/<%= sale.id %>" class="fw-semibold text-decoration-none"><%= customer %></a><div class="small text-muted">Parcela <%= item.number %>/<%= sale.installments %> · Vencimento <%= isoDate(date) %></div></div><div class="d-flex align-items-center gap-3"><strong>R$ <%= (item.amountCents/100).toFixed(2).replace('.',',') %></strong><button class="btn btn-sm btn-outline-success pay-btn" data-customer="<%= customer %>" data-number="<%= item.number %>/<%= sale.installments %>" data-amount="R$ <%= (item.amountCents/100).toFixed(2).replace('.',',') %>" data-due="<%= isoDate(date) %>" data-last="<%= pending===1 %>">Marcar como paga</button></div></div><% }) %></div></section><% }) %></div>
<% if(pagination&&pagination.totalPages>1){ %><nav class="d-flex justify-content-center gap-3 my-4"><% if(pagination.page>1){ %><a class="btn btn-sm btn-outline-secondary" href="?page=<%= pagination.page-1 %>&limit=<%= pagination.limit %>&search=<%= encodeURIComponent(search) %>">← Anterior</a><% } %><span class="small text-muted align-self-center">Página <%= pagination.page %> de <%= pagination.totalPages %></span><% if(pagination.page<pagination.totalPages){ %><a class="btn btn-sm btn-outline-secondary" href="?page=<%= pagination.page+1 %>&limit=<%= pagination.limit %>&search=<%= encodeURIComponent(search) %>">Próxima →</a><% } %></nav><% } %>
<div class="modal fade" id="paymentModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Confirmar pagamento</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><dl class="row"><dt class="col-5">Cliente</dt><dd class="col-7" id="paymentCustomer"></dd><dt class="col-5">Parcela</dt><dd class="col-7" id="paymentNumber"></dd><dt class="col-5">Valor</dt><dd class="col-7" id="paymentAmount"></dd><dt class="col-5">Vencimento</dt><dd class="col-7" id="paymentDue"></dd></dl><div id="lastWarning" class="alert alert-warning d-none">⚠️ Esta é a última parcela pendente. A venda será concluída automaticamente.</div></div><div class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-success" id="confirmPayment">Confirmar pagamento</button></div></div></div></div><div class="toast-container position-fixed bottom-0 end-0 p-3"><div id="saleToast" class="toast"><div class="toast-body">Venda concluída ✓</div></div></div>
</main><%- include('../partials/bottom-nav', {active:'sales'}) %></div></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script>(()=>{const modal=new bootstrap.Modal('#paymentModal');let selected=null;document.querySelectorAll('.agenda-filter').forEach(b=>b.onclick=()=>{document.querySelectorAll('.agenda-filter').forEach(x=>x.classList.remove('active'));b.classList.add('active');const f=b.dataset.filter;document.querySelectorAll('.agenda-day').forEach(d=>d.classList.toggle('d-none',f!=='all'&&!d.dataset.dayStatuses.split(' ').includes(f)))});document.querySelectorAll('.pay-btn').forEach(b=>b.onclick=()=>{selected=b;paymentCustomer.textContent=b.dataset.customer;paymentNumber.textContent=b.dataset.number;paymentAmount.textContent=b.dataset.amount;paymentDue.textContent=b.dataset.due;lastWarning.classList.toggle('d-none',b.dataset.last!=='true');modal.show()});confirmPayment.onclick=async()=>{if(!selected)return;confirmPayment.disabled=true;try{const r=await fetch(`/api/sales/${selected.closest('.receivable-row').dataset.saleId}/installments/${selected.closest('.receivable-row').dataset.installmentId}/payment`,{method:'POST'});const d=await r.json();if(!r.ok)throw Error(d.message||'Erro ao registrar pagamento');selected.outerHTML=`<span class="badge text-bg-success">✓ Pago em ${new Date(d.installment.paidAt).toLocaleDateString('pt-BR')}</span>`;modal.hide();if(d.saleCompleted)new bootstrap.Toast(document.getElementById('saleToast')).show()}catch(e){alert(e.message)}finally{confirmPayment.disabled=false}}})();</script></body></html>
