<%- include('../partials/head', {title: 'Mercario — Registrar pagamento'}) %>
<body><div class="page-shell"><div class="page-container"><main class="page-content"><%- include('../partials/detail-header', {title:'Registrar pagamento', backHref:'/sales/'+saleId, menuHref:null}) %>
<div class="card-mercario confirm-card mb-3"><div class="confirm-icon success"><i class="bi bi-check2-circle"></i></div><p class="confirm-title">Quitar venda</p><p id="customer" class="confirm-text">Carregando...</p><p id="total" class="hero-value mt-2"></p></div>
<div class="card-mercario form-card"><div class="section-label mt-0">Forma de pagamento</div><div class="payment-grid"><button type="button" class="payment-option selected" data-method="PIX">PIX</button><button type="button" class="payment-option" data-method="BOLETO">Boleto</button><button type="button" class="payment-option" data-method="CREDIT_CARD">Crédito</button><button type="button" class="payment-option" data-method="DEBIT_CARD">Débito</button><button type="button" class="payment-option" data-method="CASH">Dinheiro</button></div><div class="form-group mt-3"><label class="form-label">Desconto na quitação</label><input id="discount" class="form-control form-control-mercario" value="0,00" inputmode="decimal"></div><div class="form-group"><label class="form-label">Observações <span class="fw-normal text-secondary">(opcional)</span></label><textarea id="notes" class="form-control form-control-mercario" rows="2"></textarea></div><div id="error" class="error-message"></div><button id="submit" class="btn-mercario mt-2">Confirmar quitação</button></div>
</main></div></div><script>const id = <%= saleId %>;let method='PIX';const cents=v=>Math.max(0,Math.round(Number(String(v).replace(/\./g,'').replace(',','.'))*100));const brl=v=>Number(v/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});fetch('/api/sales/'+id).then(r=>r.json()).then(s=>{customer.textContent='Pedido #'+s.id+' · '+(s.customer?.name||('Cliente #'+s.customerId));total.textContent=brl(s.totalCents||s.total||0)});document.querySelectorAll('.payment-option').forEach(b=>b.onclick=()=>{document.querySelectorAll('.payment-option').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');method=b.dataset.method});submit.onclick=async()=>{const r=await fetch('/api/sales/'+id+'/settle',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({discountCents:cents(discount.value),paymentMethod:method,notes:notes.value||undefined})});if(r.ok)location.href='/sales/'+id;else{const b=await r.json().catch(()=>({}));error.textContent=b.message||'Não foi possível registrar o pagamento.';error.style.display='block'}};</script></body></html>
