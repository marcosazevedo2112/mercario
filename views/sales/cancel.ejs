<%- include('../partials/head', {title: 'Mercario — Cancelar venda'}) %>
<body><div class="page-shell"><div class="page-container"><main class="page-content"><%- include('../partials/detail-header', {title:'Cancelar venda', backHref:'/sales/'+saleId, menuHref:null}) %>
<div class="card-mercario confirm-card mb-3"><div class="confirm-icon"><i class="bi bi-exclamation-triangle"></i></div><p class="confirm-title">Cancelar esta venda?</p><p class="confirm-text">A ação não pode ser desfeita. O estoque será tratado pelo domínio de vendas.</p></div>
<div id="summary" class="card-mercario p-3 mb-3">Carregando venda...</div><div class="card-mercario form-card"><label class="form-label">Motivo do cancelamento</label><textarea id="reason" class="form-control form-control-mercario" rows="3" maxlength="500" required placeholder="Ex: cliente desistiu da compra"></textarea><div id="error" class="error-message"></div><button id="submit" class="btn-danger-mercario mt-3">Confirmar cancelamento</button></div>
</main></div></div><script>const id=<%= JSON.stringify(saleId) %>;const brl=v=>Number(v/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});fetch('/api/sales/'+id).then(r=>r.json()).then(s=>{summary.innerHTML='<p class="item-name mb-1">Pedido #'+s.id+'</p><p class="item-sub">'+brl(s.totalCents||s.total||0)+'</p>'});submit.onclick=async()=>{if(!reason.value.trim()){error.textContent='Informe o motivo.';error.style.display='block';return}const r=await fetch('/api/sales/'+id+'/cancel',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({reason:reason.value.trim()})});if(r.ok)location.href='/sales/'+id;else{const b=await r.json().catch(()=>({}));error.textContent=b.message||'Não foi possível cancelar a venda.';error.style.display='block'}};</script></body></html>
