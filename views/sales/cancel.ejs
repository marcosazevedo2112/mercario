<%- include('../partials/head', {title: `Mercario — Cancelar venda #${sale.id}`}) %>
<body><div class="page-shell"><div class="page-container"><main class="page-content"><div class="row justify-content-center"><div class="col-12 col-md-7 col-lg-6"><a href="/sales/<%= sale.id %>" class="text-decoration-none small">← Voltar para a venda</a><div class="card border-0 shadow-sm mt-3"><div class="card-body p-4"><div class="text-center mb-4"><i class="bi bi-exclamation-triangle fs-1 text-danger"></i><h1 class="h4 mt-3">Cancelar venda #<%= sale.id %></h1><p class="text-muted mb-0">Esta ação não poderá ser desfeita.</p></div><div class="alert alert-warning"><strong>Esta ação cancelará também todas as parcelas pendentes (<%= pendingCount %> parcelas).</strong></div><form id="cancelForm"><div class="mb-3"><label for="reason" class="form-label fw-semibold">Motivo do cancelamento</label><textarea id="reason" name="reason" class="form-control" rows="5" maxlength="5000" required placeholder="Informe o motivo do cancelamento..."></textarea></div><div id="error" class="alert alert-danger d-none"></div><div class="d-flex justify-content-end gap-2"><a href="/sales/<%= sale.id %>" class="btn btn-outline-secondary">Voltar</a><button class="btn btn-danger" type="submit">Confirmar cancelamento</button></div></form></div></div></div></div></main><%- include('../partials/bottom-nav', {active: 'sales'}) %></div></div><script>document.getElementById('cancelForm').onsubmit=async e=>{e.preventDefault();const b=e.currentTarget.querySelector('button[type=submit]');b.disabled=true;try{const r=await fetch('/api/sales/<%= sale.id %>/cancel',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({reason:document.getElementById('reason').value})});if(!r.ok){const d=await r.json().catch(()=>({}));throw Error(d.message||'Não foi possível cancelar a venda');}location.href='/sales/<%= sale.id %>';}catch(err){const el=document.getElementById('error');el.textContent=err.message;el.classList.remove('d-none');b.disabled=false;}}</script></body></html>
