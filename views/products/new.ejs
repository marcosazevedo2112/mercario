<%- include('../partials/head', {title: 'Mercario — Novo produto'}) %>
<body><div class="page-shell"><div class="page-container"><main class="page-content"><%- include('../partials/detail-header', {title:'Novo produto', backHref:'/products', menuHref:null}) %>
<form id="form" class="card-mercario form-card">
<div class="form-group mb-3"><label class="form-label">Nome do produto</label><input name="name" class="form-control form-control-mercario" required maxlength="150" placeholder="Ex: Shampoo Elseve"></div>
<div class="form-group mb-3"><label class="form-label">Descrição <span class="fw-normal text-secondary">(opcional)</span></label><textarea name="description" class="form-control form-control-mercario" rows="3" maxlength="500" placeholder="Descrição do produto"></textarea></div>
<div class="row g-2"><div class="col-6"><label class="form-label">Preço de custo</label><input id="cost" class="form-control form-control-mercario" inputmode="decimal" placeholder="0,00" required></div><div class="col-6"><label class="form-label">Preço de venda</label><input id="price" class="form-control form-control-mercario" inputmode="decimal" placeholder="0,00" required></div></div>
<p class="form-hint">Os preços são enviados à API em centavos.</p><div id="error" class="error-message"></div><button class="btn-mercario mt-3" type="submit">Salvar produto</button>
</form></main></div></div>
<script>const cents=v=>Math.round(Number(String(v).replace(/\./g,'').replace(',','.'))*100);form.addEventListener('submit',async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(form));data.costPriceCents=cents(cost.value);data.priceCents=cents(price.value);delete data.cost;delete data.price;try{const r=await fetch('/api/products',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const b=await r.json().catch(()=>({}));if(!r.ok)throw new Error(b.message||'Não foi possível criar o produto.');location.href='/products/'+b.id}catch(err){error.textContent=err.message;error.style.display='block'}});</script></body></html>
