<%- include('../partials/head', {title: 'Mercario — Editar produto'}) %>
<body><div class="page-shell"><div class="page-container"><main class="page-content"><%- include('../partials/detail-header', {title:'Editar produto', backHref:'/products/'+productId, menuHref:null}) %>
<form id="form" class="card-mercario form-card"><div id="loading" class="empty-state p-3">Carregando...</div><div id="fields" style="display:none">
<div class="form-group mb-3"><label class="form-label">Nome do produto</label><input id="name" name="name" class="form-control form-control-mercario" required maxlength="150"></div>
<div class="form-group mb-3"><label class="form-label">Descrição <span class="fw-normal text-secondary">(opcional)</span></label><textarea id="description" name="description" class="form-control form-control-mercario" rows="3" maxlength="500"></textarea></div>
<div class="row g-2"><div class="col-6"><label class="form-label">Preço de custo</label><input id="cost" class="form-control form-control-mercario" inputmode="decimal" required></div><div class="col-6"><label class="form-label">Preço de venda</label><input id="price" class="form-control form-control-mercario" inputmode="decimal" required></div></div>
<div id="error" class="error-message"></div><button class="btn-mercario mt-3" type="submit">Salvar alterações</button><button id="delete" type="button" class="btn-danger-mercario mt-2">Excluir produto</button></div></form>
</main></div></div><script>const id=<%= JSON.stringify(productId) %>;const money=v=>(Number(v)/100).toFixed(2).replace('.',',');const cents=v=>Math.round(Number(String(v).replace(/\./g,'').replace(',','.'))*100);fetch('/api/products/'+id).then(r=>r.ok?r.json():Promise.reject(new Error('Produto não encontrado'))).then(p=>{name.value=p.name;description.value=p.description||'';cost.value=money(p.costPriceCents);price.value=money(p.priceCents);loading.style.display='none';fields.style.display='block'}).catch(e=>loading.textContent=e.message);form.addEventListener('submit',async e=>{e.preventDefault();const data={name:name.value,description:description.value||null,costPriceCents:cents(cost.value),priceCents:cents(price.value)};try{const r=await fetch('/api/products/'+id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const b=await r.json().catch(()=>({}));if(!r.ok)throw new Error(b.message||'Não foi possível salvar.');location.href='/products/'+id}catch(err){error.textContent=err.message;error.style.display='block'}});delete.onclick=async()=>{if(!confirm('Excluir este produto?'))return;const r=await fetch('/api/products/'+id,{method:'DELETE'});if(r.ok)location.href='/products';else{error.textContent='Não foi possível excluir o produto.';error.style.display='block'}};</script></body></html>
