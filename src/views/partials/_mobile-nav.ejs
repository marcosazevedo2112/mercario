<nav class="mobile-topbar d-lg-none sticky-top">
  <div class="d-flex align-items-center justify-content-between px-3 py-2">
    <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
      <span class="sidebar-brand" aria-hidden="true"><i class="bi bi-shop"></i></span>
      <strong style="color:var(--mc-text);letter-spacing:var(--mc-tracking-tight)">Mercario</strong>
    </a>
    <button class="btn btn-outline-secondary btn-sm btn-icon" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-label="Abrir menu"><i class="bi bi-list"></i></button>
  </div>
</nav>
<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenu" aria-labelledby="mobileMenuLabel">
  <div class="offcanvas-header" style="border-bottom:1px solid var(--mc-border)">
    <div class="d-flex align-items-center gap-2">
      <span class="sidebar-brand" style="width:32px;height:32px"><i class="bi bi-shop"></i></span>
      <strong id="mobileMenuLabel" style="letter-spacing:var(--mc-tracking-tight)">Mercario</strong>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
  </div>
  <div class="offcanvas-body d-flex flex-column">
    <% const _p = typeof currentPath !== 'undefined' ? currentPath : ''; %>
    <ul class="nav flex-column gap-1">
      <li class="nav-item"><a class="nav-link <%= _p === '/' ? 'active' : '' %>" href="/"><i class="bi bi-grid me-2"></i>Visão geral</a></li>
      <li class="nav-item"><a class="nav-link <%= _p.startsWith('/sales') ? 'active' : '' %>" href="/sales"><i class="bi bi-receipt me-2"></i>Vendas</a></li>
      <li class="nav-item"><a class="nav-link <%= _p.startsWith('/installments') ? 'active' : '' %>" href="/installments"><i class="bi bi-calendar-week me-2"></i>Parcelas</a></li>
      <li class="nav-item"><a class="nav-link <%= _p.startsWith('/customers') ? 'active' : '' %>" href="/customers"><i class="bi bi-people me-2"></i>Clientes</a></li>
      <li class="nav-item"><a class="nav-link <%= _p.startsWith('/products') ? 'active' : '' %>" href="/products"><i class="bi bi-box-seam me-2"></i>Produtos</a></li>
    </ul>
    <% if (typeof user !== 'undefined' && user) { %>
      <div class="mt-auto pt-3" style="border-top:1px solid var(--mc-border)">
        <div class="small mb-2" style="color:var(--mc-text-muted)"><%= user.email %></div>
        <form action="/auth/logout" method="POST"><button class="btn btn-outline-secondary btn-sm w-100">Sair</button></form>
      </div>
    <% } %>
  </div>
</div>
