<nav class="d-lg-none bg-white border-bottom sticky-top">
  <div class="d-flex align-items-center justify-content-between px-3 py-2">
    <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
      <span class="bg-dark text-white rounded-3 d-inline-flex align-items-center justify-content-center" style="width:32px;height:32px;"><i class="bi bi-shop"></i></span>
      <strong class="text-dark">Mercario</strong>
    </a>
    <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu"><i class="bi bi-list"></i></button>
  </div>
</nav>
<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenu">
  <div class="offcanvas-header border-bottom">
    <strong>Mercario</strong>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body">
    <% const _p = typeof currentPath !== 'undefined' ? currentPath : ''; %>
    <ul class="nav flex-column gap-1">
      <li class="nav-item"><a class="nav-link <%= _p === '/' ? 'active fw-semibold' : '' %>" href="/"><i class="bi bi-grid me-2"></i>Visão geral</a></li>
      <li class="nav-item"><a class="nav-link <%= _p.startsWith('/sales') ? 'active fw-semibold' : '' %>" href="/sales"><i class="bi bi-receipt me-2"></i>Vendas</a></li>
      <li class="nav-item"><a class="nav-link <%= _p.startsWith('/installments') ? 'active fw-semibold' : '' %>" href="/installments"><i class="bi bi-calendar-week me-2"></i>Parcelas</a></li>
      <li class="nav-item"><a class="nav-link <%= _p.startsWith('/customers') ? 'active fw-semibold' : '' %>" href="/customers"><i class="bi bi-people me-2"></i>Clientes</a></li>
      <li class="nav-item"><a class="nav-link <%= _p.startsWith('/products') ? 'active fw-semibold' : '' %>" href="/products"><i class="bi bi-box-seam me-2"></i>Produtos</a></li>
    </ul>
    <% if (typeof user !== 'undefined' && user) { %>
      <div class="mt-4 pt-3 border-top">
        <div class="small text-muted mb-2"><%= user.email %></div>
        <form action="/auth/logout" method="POST"><button class="btn btn-outline-secondary btn-sm w-100">Sair</button></form>
      </div>
    <% } %>
  </div>
</div>
