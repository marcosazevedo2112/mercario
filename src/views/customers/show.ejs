<div class="mb-4">
  <a href="/customers" class="small text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Clientes</a>
  <div class="d-flex align-items-start justify-content-between mt-2 flex-wrap gap-3">
    <div>
      <h1 class="h4 fw-bold mb-1"><%= customer.name %></h1>
      <% if(customer.nickname){ %><p class="text-muted small mb-1"><%= customer.nickname %></p><% } %>
      <span class="badge <%= customer.active ? 'bg-success' : 'bg-secondary' %>"><%= customer.active ? 'Ativo' : 'Inativo' %></span>
    </div>
    <div class="d-flex gap-2">
      <a href="/customers/<%= customer.id %>/edit" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i> Editar</a>
      <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal"><i class="bi bi-trash me-1"></i> Excluir</button>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header bg-white fw-semibold">Informações</div>
      <div class="card-body">
        <div class="row g-3">
          <% if(customer.phone){ %>
            <div class="col-md-6"><div class="small text-muted">Telefone</div><div class="fw-medium"><i class="bi bi-telephone me-1"></i><%= customer.phone %></div></div>
          <% } %>
          <% if(customer.email){ %>
            <div class="col-md-6"><div class="small text-muted">E-mail</div><div class="fw-medium"><%= customer.email %></div></div>
          <% } %>
          <% if(customer.address){ %>
            <div class="col-12"><div class="small text-muted">Endereço</div><div><%= customer.address %></div></div>
          <% } %>
          <% if(customer.notes){ %>
            <div class="col-12"><div class="small text-muted">Observações</div><div class="border rounded-3 p-3 bg-light"><%= customer.notes %></div></div>
          <% } %>
          <% if(!customer.phone && !customer.email && !customer.address && !customer.notes){ %>
            <div class="col-12 text-muted small">Nenhuma informação adicional cadastrada.</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card">
      <div class="card-body">
        <h2 class="h6 fw-semibold mb-3">Ações rápidas</h2>
        <div class="d-grid gap-2">
          <a href="/sales/new?customerId=<%= customer.id %>" class="btn btn-dark"><i class="bi bi-receipt me-1"></i> Nova venda para este cliente</a>
          <a href="/sales?customerId=<%= customer.id %>" class="btn btn-outline-secondary"><i class="bi bi-list me-1"></i> Ver vendas do cliente</a>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Excluir cliente?</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body"><p class="mb-0">O cliente <strong><%= customer.name %></strong> será desativado e não aparecerá mais nas listas. Vendas já registradas não serão afetadas.</p></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <form action="/customers/<%= customer.id %>/delete" method="POST" class="d-inline"><button class="btn btn-danger">Excluir</button></form>
      </div>
    </div>
  </div>
</div>
