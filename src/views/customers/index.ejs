<div class="mc-page-header">
  <div class="mc-page-title-row">
    <div>
      <h1>Clientes</h1>
      <p><%= customers.length %> cliente(s)</p>
    </div>
    <a href="/customers/new" class="btn btn-dark"><i class="bi bi-person-plus me-1"></i> Novo cliente</a>
  </div>
</div>

<form method="GET" class="mb-3">
  <div class="input-group" style="max-width:420px;">
    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
    <input type="search" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Buscar por nome, apelido, telefone ou e-mail" class="form-control">
    <button class="btn btn-outline-secondary">Buscar</button>
  </div>
</form>

<% if (!customers || customers.length === 0) { %>
  <div class="card"><div class="empty-state">
    <div class="icon"><i class="bi bi-people"></i></div>
    <p class="fw-medium mb-1">Nenhum cliente encontrado</p>
    <p class="small mb-3" style="color:var(--mc-text-muted)">Cadastre seu primeiro cliente para começar.</p>
    <a href="/customers/new" class="btn btn-dark btn-sm">Cadastrar cliente</a>
  </div></div>
<% } else { %>
  <div class="card overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Cliente</th><th>Contato</th><th>Status</th><th class="text-end">Ações</th></tr></thead>
        <tbody>
          <% customers.forEach(function(c){ %>
            <tr>
              <td>
                <a href="/customers/<%= c.id %>" class="fw-medium text-decoration-none" style="color:var(--mc-text)"><%= c.name %></a>
                <% if(c.nickname){ %><div class="small" style="color:var(--mc-text-muted)"><%= c.nickname %></div><% } %>
              </td>
              <td>
                <% if(c.phone){ %><div class="small"><i class="bi bi-telephone me-1" style="color:var(--mc-text-muted)"></i><%= c.phone %></div><% } %>
                <% if(c.email){ %><div class="small" style="color:var(--mc-text-muted)"><%= c.email %></div><% } %>
                <% if(!c.phone && !c.email){ %><span class="small" style="color:var(--mc-text-faint)">—</span><% } %>
              </td>
              <td><span class="badge <%= c.active ? 'bg-success' : 'bg-secondary' %>"><%= c.active ? 'Ativo' : 'Inativo' %></span></td>
              <td class="text-end">
                <a href="/customers/<%= c.id %>" class="btn btn-sm btn-outline-secondary">Ver</a>
                <a href="/customers/<%= c.id %>/edit" class="btn btn-sm btn-outline-primary">Editar</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>
