<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h1 class="h4 fw-bold mb-1">Visão geral</h1>
    <p class="text-muted small mb-0">Acompanhe suas vendas e recebimentos</p>
  </div>
  <a href="/sales/new" class="btn btn-dark"><i class="bi bi-plus-lg me-1"></i> Nova venda</a>
</div>

<!-- Cards resumo -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="small text-muted mb-1">A receber</div>
        <div class="h5 fw-bold mb-1"><%= (pendingTotal/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></div>
        <div class="small text-muted"><%= pending.length %> parcela(s) pendente(s)</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card h-100 border-warning">
      <div class="card-body">
        <div class="small text-muted mb-1">Vencidas</div>
        <div class="h5 fw-bold mb-1 text-danger"><%= (overdueTotal/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></div>
        <div class="small text-muted"><%= overdue.length %> parcela(s) vencida(s)</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="small text-muted mb-1">Recebido</div>
        <div class="h5 fw-bold mb-1 text-success"><%= (receivedTotal/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></div>
        <div class="small text-muted">Parcelas pagas</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="small text-muted mb-1">Clientes / Produtos</div>
        <div class="h5 fw-bold mb-1"><%= customersCount %> / <%= productsCount %></div>
        <div class="small"><a href="/customers" class="text-decoration-none">Clientes</a> · <a href="/products" class="text-decoration-none">Produtos</a></div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Agenda -->
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header bg-white d-flex align-items-center justify-content-between">
        <h2 class="h6 fw-semibold mb-0"><i class="bi bi-calendar-week me-2"></i>Agenda financeira</h2>
        <a href="/sales" class="small text-decoration-none">Ver vendas</a>
      </div>
      <div class="card-body">
        <% if (!agenda || agenda.length === 0) { %>
          <div class="empty-state py-4">
            <div class="icon"><i class="bi bi-calendar-check text-muted"></i></div>
            <p class="mb-1 fw-medium">Nenhuma parcela pendente</p>
            <p class="small text-muted mb-3">Suas próximas parcelas aparecerão aqui.</p>
            <a href="/sales/new" class="btn btn-sm btn-dark">Nova venda</a>
          </div>
        <% } else { %>
          <% agenda.forEach(function(group){ %>
            <% const isToday = group.date === today; const isOverdue = group.date < today; %>
            <div class="mb-3">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge <%= isToday ? 'bg-dark' : isOverdue ? 'bg-danger' : 'bg-secondary' %>"><%= group.date.split('-').reverse().join('/') %></span>
                <% if(isToday){ %><span class="small fw-semibold">Hoje</span><% } %>
                <% if(isOverdue){ %><span class="small text-danger fw-semibold">Vencido</span><% } %>
                <span class="small text-muted"><%= group.items.length %> parcela(s) · <%= (group.items.reduce((s,i)=>s+(i.amountCents||0),0)/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></span>
              </div>
              <div class="d-flex flex-column gap-2">
                <% group.items.forEach(function(inst){ %>
                  <% const sale = inst.sale || {}; %>
                  <div class="d-flex align-items-center justify-content-between border rounded-3 px-3 py-2 <%= isOverdue ? 'bg-danger bg-opacity-10 border-danger' : '' %>">
                    <div>
                      <div class="small fw-medium">Parcela <%= inst.number %>/<%= sale.installments || '?' %> · <%= (inst.amountCents/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></div>
                      <div class="small text-muted">Venda #<%= inst.saleId %> · <span class="badge badge-status <%= inst.status==='PAID' ? 'bg-success' : inst.status==='SETTLED' ? 'bg-info text-dark' : inst.status==='CANCELED' ? 'bg-secondary' : 'bg-warning text-dark' %>"><%= inst.status==='PENDING' ? 'Pendente' : inst.status %></span></div>
                    </div>
                    <a href="/sales/<%= inst.saleId %>" class="btn btn-sm btn-outline-secondary">Ver</a>
                  </div>
                <% }) %>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Últimas vendas -->
  <div class="col-lg-5">
    <div class="card">
      <div class="card-header bg-white d-flex align-items-center justify-content-between">
        <h2 class="h6 fw-semibold mb-0">Últimas vendas</h2>
        <a href="/sales" class="small text-decoration-none">Ver todas</a>
      </div>
      <div class="list-group list-group-flush">
        <% if (!sales || sales.length===0) { %>
          <div class="p-4 text-center text-muted small">Nenhuma venda ainda. <a href="/sales/new">Criar venda</a></div>
        <% } else { %>
          <% sales.forEach(function(s){ %>
            <a href="/sales/<%= s.id %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
              <div>
                <div class="fw-medium small">Venda #<%= s.id %> · <%= (s.totalCents/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></div>
                <div class="small text-muted"><%= new Date(s.createdAt).toLocaleDateString('pt-BR') %> · <%= s.status==='OPEN'?'Aberta':s.status==='CANCELED'?'Cancelada':'Concluída' %></div>
              </div>
              <span class="badge <%= s.status==='OPEN'?'bg-warning text-dark':s.status==='CANCELED'?'bg-danger':'bg-success' %>"><%= s.status==='OPEN'?'Aberta':s.status==='CANCELED'?'Cancelada':'Concluída' %></span>
            </a>
          <% }) %>
        <% } %>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-body d-flex gap-2">
        <a href="/sales/new" class="btn btn-dark flex-fill"><i class="bi bi-plus-lg me-1"></i> Nova venda</a>
        <a href="/customers/new" class="btn btn-outline-secondary flex-fill"><i class="bi bi-person-plus me-1"></i> Novo cliente</a>
      </div>
    </div>
  </div>
</div>
