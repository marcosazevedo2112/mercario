<div class="mc-page-header">
  <div class="mc-page-title-row">
    <div>
      <h1>Visão geral</h1>
      <p>Acompanhe suas vendas e recebimentos</p>
    </div>
    <a href="/sales/new" class="btn btn-dark"><i class="bi bi-plus-lg me-1"></i> Nova venda</a>
  </div>
</div>

<!-- Cards resumo -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="mc-stat-card h-100">
      <div class="mc-stat-label"><i class="bi bi-hourglass-split"></i> A receber</div>
      <div class="mc-stat-value"><%= (pendingTotal/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></div>
      <div class="mc-stat-foot"><%= pending.length %> parcela(s) pendente(s)</div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="mc-stat-card h-100" style="border-color:var(--mc-danger-border)">
      <div class="mc-stat-label"><i class="bi bi-exclamation-triangle" style="color:var(--mc-danger)"></i> Vencidas</div>
      <div class="mc-stat-value" style="color:var(--mc-danger)"><%= (overdueTotal/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></div>
      <div class="mc-stat-foot"><%= overdue.length %> parcela(s) vencida(s)</div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="mc-stat-card h-100">
      <div class="mc-stat-label"><i class="bi bi-check-circle" style="color:var(--mc-success)"></i> Recebido</div>
      <div class="mc-stat-value" style="color:var(--mc-success)"><%= (receivedTotal/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></div>
      <div class="mc-stat-foot">Parcelas pagas</div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="mc-stat-card h-100">
      <div class="mc-stat-label"><i class="bi bi-people"></i> Clientes / Produtos</div>
      <div class="mc-stat-value"><%= customersCount %> <span style="font-weight:400;color:var(--mc-text-muted);font-size:0.85em">/</span> <%= productsCount %></div>
      <div class="mc-stat-foot"><a href="/customers" class="text-decoration-none" style="color:var(--mc-text-muted)">Clientes</a> · <a href="/products" class="text-decoration-none" style="color:var(--mc-text-muted)">Produtos</a></div>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Agenda -->
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header d-flex align-items-center justify-content-between">
        <span><i class="bi bi-calendar-week me-2" style="color:var(--mc-text-muted)"></i>Agenda financeira</span>
        <a href="/sales" class="small text-decoration-none" style="font-weight:500">Ver vendas</a>
      </div>
      <div class="card-body">
        <% if (!agenda || agenda.length === 0) { %>
          <div class="empty-state py-4">
            <div class="icon"><i class="bi bi-calendar-check"></i></div>
            <p class="fw-medium mb-1">Nenhuma parcela pendente</p>
            <p class="small mb-3" style="color:var(--mc-text-muted)">Suas próximas parcelas aparecerão aqui.</p>
            <a href="/sales/new" class="btn btn-dark btn-sm">Nova venda</a>
          </div>
        <% } else { %>
          <% agenda.forEach(function(group){ %>
            <% const isToday = group.date === today; const isOverdue = group.date < today; %>
            <div class="mb-3">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge <%= isToday ? 'bg-dark' : isOverdue ? 'bg-danger' : 'bg-secondary' %>"><%= group.date.split('-').reverse().join('/') %></span>
                <% if(isToday){ %><span class="small fw-semibold">Hoje</span><% } %>
                <% if(isOverdue){ %><span class="small fw-semibold" style="color:var(--mc-danger)">Vencido</span><% } %>
                <span class="small" style="color:var(--mc-text-muted)"><%= group.items.length %> parcela(s) · <%= (group.items.reduce((s,i)=>s+(i.amountCents||0),0)/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></span>
              </div>
              <div class="d-flex flex-column gap-2">
                <% group.items.forEach(function(inst){ %>
                  <% const sale = inst.sale || {}; %>
                  <a href="/sales/<%= inst.saleId %>" class="d-flex align-items-center justify-content-between border rounded-3 px-3 py-2 text-decoration-none <%= isOverdue ? 'bg-danger bg-opacity-10' : 'bg-white' %>" style="border-color:<%= isOverdue ? 'var(--mc-danger-border)' : 'var(--mc-border)' %>">
                    <div>
                      <div class="small fw-medium" style="color:var(--mc-text)">Parcela <%= inst.number %>/<%= sale.installments || '?' %> · <span class="mc-money"><%= (inst.amountCents/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></span></div>
                      <div class="small" style="color:var(--mc-text-muted)">Venda #<%= inst.saleId %> · <span class="badge <%= inst.status==='PAID' ? 'bg-success' : inst.status==='SETTLED' ? 'bg-info' : inst.status==='CANCELED' ? 'bg-secondary' : 'bg-warning' %>"><%= inst.status==='PENDING' ? 'Pendente' : inst.status %></span></div>
                    </div>
                    <i class="bi bi-chevron-right" style="color:var(--mc-text-faint)"></i>
                  </a>
                <% }) %>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Últimas vendas -->
  <div class="col-lg-5">
    <div class="card">
      <div class="card-header d-flex align-items-center justify-content-between">
        <span>Últimas vendas</span>
        <a href="/sales" class="small text-decoration-none" style="font-weight:500">Ver todas</a>
      </div>
      <div class="list-group list-group-flush">
        <% if (!sales || sales.length===0) { %>
          <div class="p-4 text-center small" style="color:var(--mc-text-muted)">Nenhuma venda ainda. <a href="/sales/new">Criar venda</a></div>
        <% } else { %>
          <% sales.forEach(function(s){ %>
            <a href="/sales/<%= s.id %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
              <div>
                <div class="fw-medium small">Venda #<%= s.id %> · <span class="mc-money"><%= (s.totalCents/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></span></div>
                <div class="small" style="color:var(--mc-text-muted)"><%= new Date(s.createdAt).toLocaleDateString('pt-BR') %> · <%= s.status==='OPEN'?'Aberta':s.status==='CANCELED'?'Cancelada':'Concluída' %></div>
              </div>
              <span class="badge <%= s.status==='OPEN'?'bg-warning':s.status==='CANCELED'?'bg-danger':'bg-success' %>"><%= s.status==='OPEN'?'Aberta':s.status==='CANCELED'?'Cancelada':'Concluída' %></span>
            </a>
          <% }) %>
        <% } %>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-body d-flex gap-2">
        <a href="/sales/new" class="btn btn-dark flex-fill"><i class="bi bi-plus-lg me-1"></i> Nova venda</a>
        <a href="/customers/new" class="btn btn-outline-secondary flex-fill"><i class="bi bi-person-plus me-1"></i> Novo cliente</a>
      </div>
    </div>
  </div>
</div>
