<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
  <div>
    <h1 class="h4 fw-bold mb-1">Produtos</h1>
    <p class="text-muted small mb-0"><%= products.length %> produto(s)</p>
  </div>
  <a href="/products/new" class="btn btn-dark"><i class="bi bi-plus-lg me-1"></i> Novo produto</a>
</div>

<form method="GET" class="mb-3">
  <div class="input-group" style="max-width:400px;">
    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
    <input type="search" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Buscar por nome ou descrição" class="form-control">
    <button class="btn btn-outline-secondary">Buscar</button>
  </div>
</form>

<% if (!products || products.length === 0) { %>
  <div class="card"><div class="empty-state">
    <div class="icon"><i class="bi bi-box-seam"></i></div>
    <p class="fw-medium mb-1">Nenhum produto cadastrado</p>
    <p class="small text-muted mb-3">Cadastre seu primeiro produto para começar a vender.</p>
    <a href="/products/new" class="btn btn-dark btn-sm">Cadastrar produto</a>
  </div></div>
<% } else { %>
  <div class="card overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr><th>Produto</th><th>Preço</th><th>Custo</th><th>Status</th><th class="text-end">Ações</th></tr>
        </thead>
        <tbody>
          <% products.forEach(function(p){ %>
            <tr>
              <td>
                <a href="/products/<%= p.id %>" class="fw-medium text-dark text-decoration-none"><%= p.name %></a>
                <% if(p.description){ %><div class="small text-muted text-truncate" style="max-width:280px;"><%= p.description %></div><% } %>
              </td>
              <td class="fw-semibold"><%= (p.priceCents/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></td>
              <td class="small text-muted"><%= (p.costPriceCents/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></td>
              <td><span class="badge <%= p.active ? 'bg-success' : 'bg-secondary' %>"><%= p.active ? 'Ativo' : 'Inativo' %></span></td>
              <td class="text-end">
                <a href="/products/<%= p.id %>" class="btn btn-sm btn-outline-secondary">Ver</a>
                <a href="/products/<%= p.id %>/edit" class="btn btn-sm btn-outline-primary">Editar</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>
