<div class="mb-4">
  <a href="/products" class="small text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Produtos</a>
  <div class="d-flex align-items-start justify-content-between mt-2 flex-wrap gap-3">
    <div>
      <h1 class="h4 fw-bold mb-1" style="letter-spacing:var(--mc-tracking-tight)"><%= product.name %></h1>
      <span class="badge <%= product.active ? 'bg-success' : 'bg-secondary' %>"><%= product.active ? 'Ativo' : 'Inativo' %></span>
    </div>
    <div class="d-flex gap-2">
      <a href="/products/<%= product.id %>/edit" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i> Editar</a>
      <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal"><i class="bi bi-trash me-1"></i> Excluir</button>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-body">
        <div class="row g-3">
          <div class="col-6">
            <div class="small" style="color:var(--mc-text-muted)">Preço de venda</div>
            <div class="mc-money mc-money-lg" style="color:var(--mc-success)"><%= (product.priceCents/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></div>
          </div>
          <div class="col-6">
            <div class="small" style="color:var(--mc-text-muted)">Preço de custo</div>
            <div class="mc-money" style="font-size:1.1rem"><%= (product.costPriceCents/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></div>
          </div>
        </div>
        <% if(product.description){ %>
          <hr>
          <div class="small mb-1" style="color:var(--mc-text-muted)">Descrição</div>
          <p class="mb-0"><%= product.description %></p>
        <% } %>
        <hr>
        <div class="small" style="color:var(--mc-text-muted)">Cadastrado em <%= new Date(product.createdAt).toLocaleDateString('pt-BR') %></div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Excluir produto?</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div>
      <div class="modal-body"><p class="mb-0">Esta ação desativará o produto <strong><%= product.name %></strong>. Ele não aparecerá mais nas listas, mas vendas já registradas não serão afetadas.</p></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <form action="/products/<%= product.id %>/delete" method="POST" class="d-inline"><button class="btn btn-danger">Excluir</button></form>
      </div>
    </div>
  </div>
</div>
