<div class="mb-4">
  <a href="/sales" class="small text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Vendas</a>
  <h1 class="h4 fw-bold mt-2 mb-1" style="letter-spacing:var(--mc-tracking-tight)">Nova venda</h1>
  <p class="small mb-0" style="color:var(--mc-text-muted)">Selecione cliente, produtos e forma de pagamento</p>
</div>

<!-- Stepper -->
<div class="d-flex align-items-center gap-2 mb-4 small" style="color:var(--mc-text-muted)">
  <span class="badge bg-dark">1</span> Cliente
  <span style="color:var(--mc-border-strong)">—</span>
  <span class="badge bg-dark">2</span> Produtos
  <span style="color:var(--mc-border-strong)">—</span>
  <span class="badge bg-dark">3</span> Pagamento
  <span style="color:var(--mc-border-strong)">—</span>
  <span class="badge bg-dark">4</span> Confirmação
</div>

<form id="saleForm" action="/sales" method="POST" data-prevent-double novalidate>
  <!-- Cliente -->
  <div class="card mb-3">
    <div class="card-header d-flex align-items-center gap-2"><span class="badge bg-dark">1</span> Cliente</div>
    <div class="card-body">
      <label for="customerId" class="form-label">Cliente <span style="color:var(--mc-danger)">*</span></label>
      <select id="customerId" name="customerId" class="form-select" required>
        <option value="">Selecione um cliente</option>
        <% customers.forEach(function(c){ %>
          <option value="<%= c.id %>" <%= (typeof preselectedCustomerId !== 'undefined' && String(preselectedCustomerId)===String(c.id)) ? 'selected' : '' %>><%= c.name %><%= c.nickname ? ' ('+c.nickname+')' : '' %><%= c.phone ? ' — ' + c.phone : '' %></option>
        <% }) %>
      </select>
      <% if(customers.length===0){ %><div class="small mt-2" style="color:var(--mc-text-muted)">Nenhum cliente ativo. <a href="/customers/new">Cadastrar cliente</a></div><% } %>
    </div>
  </div>

  <!-- Produtos -->
  <div class="card mb-3">
    <div class="card-header d-flex align-items-center justify-content-between">
      <span class="d-flex align-items-center gap-2"><span class="badge bg-dark">2</span> Produtos</span>
      <button type="button" class="btn btn-sm btn-outline-secondary" id="addItemBtn"><i class="bi bi-plus-lg me-1"></i> Adicionar item</button>
    </div>
    <div class="card-body">
      <div id="itemsContainer" class="d-flex flex-column gap-3"></div>
      <div id="emptyItems" class="text-center small py-3 border rounded-3 border-dashed" style="color:var(--mc-text-muted)">Nenhum produto adicionado ainda.</div>
      <!-- Resumo -->
      <div class="mt-3 pt-3" style="border-top:1px solid var(--mc-border)">
        <div class="d-flex justify-content-between small"><span style="color:var(--mc-text-muted)">Subtotal</span><span id="subtotalLabel" class="mc-money">R$ 0,00</span></div>
        <div class="d-flex justify-content-between small align-items-center mt-2">
          <label for="discount" class="mb-0 form-label">Desconto (R$)</label>
          <input type="text" id="discount" name="discount" value="0,00" class="form-control form-control-sm text-end" style="max-width:140px;" placeholder="0,00">
        </div>
        <div class="d-flex justify-content-between fw-bold mt-2 pt-2" style="border-top:1px solid var(--mc-border)"><span>Total</span><span id="totalLabel" class="mc-money mc-money-lg">R$ 0,00</span></div>
      </div>
    </div>
  </div>

  <!-- Pagamento -->
  <div class="card mb-3">
    <div class="card-header d-flex align-items-center gap-2"><span class="badge bg-dark">3</span> Pagamento</div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <label for="paymentMethod" class="form-label">Método <span style="color:var(--mc-danger)">*</span></label>
          <select id="paymentMethod" name="paymentMethod" class="form-select" required>
            <option value="PIX">PIX</option>
            <option value="BOLETO">Boleto</option>
            <option value="CREDIT_CARD">Cartão de crédito</option>
            <option value="DEBIT_CARD">Cartão de débito</option>
            <option value="CASH">Dinheiro</option>
          </select>
        </div>
        <div class="col-md-3">
          <label for="installments" class="form-label">Parcelas <span style="color:var(--mc-danger)">*</span></label>
          <input type="number" id="installments" name="installments" class="form-control" min="1" value="1" required>
        </div>
        <div class="col-md-3">
          <label for="modality" class="form-label">Modalidade <span style="color:var(--mc-danger)">*</span></label>
          <select id="modality" name="modality" class="form-select" required>
            <option value="ONCE">À vista</option>
            <option value="WEEKLY">Semanal</option>
            <option value="MONTHLY" selected>Mensal</option>
          </select>
        </div>
        <div class="col-md-2">
          <label for="initialDueDate" class="form-label">1º vencimento <span style="color:var(--mc-danger)">*</span></label>
          <input type="date" id="initialDueDate" name="initialDueDate" class="form-control" value="<%= new Date().toISOString().slice(0,10) %>" required>
        </div>
      </div>
      <div class="small mt-2" style="color:var(--mc-text-muted)">À vista exige exatamente 1 parcela.</div>
    </div>
  </div>

  <!-- Observações -->
  <div class="card mb-4">
    <div class="card-header d-flex align-items-center gap-2"><span class="badge bg-dark">4</span> Observações</div>
    <div class="card-body">
      <textarea name="notes" rows="2" maxlength="500" class="form-control" placeholder="Observações opcionais (máx. 500 caracteres)"></textarea>
    </div>
  </div>

  <!-- Confirmação -->
  <div class="card mb-4" style="border-color:var(--mc-primary)">
    <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">
      <div>
        <div class="fw-semibold">Revise antes de confirmar</div>
        <div class="small" style="color:var(--mc-text-muted)">A venda será criada e confirmada imediatamente.</div>
      </div>
      <button type="submit" class="btn btn-dark btn-lg px-4" id="submitBtn"><i class="bi bi-check-lg me-1"></i> Confirmar venda</button>
    </div>
  </div>

  <input type="hidden" name="items" id="itemsJson">
</form>

<template id="itemRowTemplate">
  <div class="item-row border rounded-3 p-3" style="border-color:var(--mc-border)">
    <div class="row g-2 align-items-end">
      <div class="col-md-6">
        <label class="form-label">Produto</label>
        <select class="form-select product-select" required>
          <option value="">Selecione</option>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label">Qtd</label>
        <input type="number" class="form-control qty-input" min="1" value="1" required>
      </div>
      <div class="col-md-2">
        <label class="form-label">Preço</label>
        <div class="price-label small fw-semibold" style="color:var(--mc-success)">—</div>
      </div>
      <div class="col-md-2 d-flex gap-2 align-items-end">
        <div class="flex-fill">
          <label class="form-label">Subtotal</label>
          <div class="subtotal-label small fw-bold mc-money">—</div>
        </div>
        <button type="button" class="btn btn-outline-danger btn-sm btn-icon remove-row" title="Remover"><i class="bi bi-trash"></i></button>
      </div>
    </div>
  </div>
</template>

<script>
(function(){
  var products = <%- JSON.stringify(products.map(function(p){ return {id:p.id, name:p.name, priceCents:p.priceCents}; })) %>;
  var productMap = {};
  products.forEach(function(p){ productMap[p.id]=p; });
  var container = document.getElementById('itemsContainer');
  var emptyMsg = document.getElementById('emptyItems');
  var subtotalLabel = document.getElementById('subtotalLabel');
  var totalLabel = document.getElementById('totalLabel');
  var discountInput = document.getElementById('discount');
  var itemsJson = document.getElementById('itemsJson');
  var installmentsInput = document.getElementById('installments');
  var modalitySelect = document.getElementById('modality');

  function brl(cents){ return (cents/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}); }
  function parseBRL(str){
    if(!str) return 0;
    var s = String(str).trim().replace(/\./g,'').replace(',','.');
    var n = Number(s);
    return isNaN(n) ? 0 : Math.round(n*100);
  }
  function createRow(){
    var tpl = document.getElementById('itemRowTemplate');
    var clone = tpl.content.cloneNode(true);
    var row = clone.querySelector('.item-row');
    var select = row.querySelector('.product-select');
    products.forEach(function(p){
      var opt = document.createElement('option');
      opt.value = p.id;
      opt.textContent = p.name + ' — ' + brl(p.priceCents);
      select.appendChild(opt);
    });
    row.querySelector('.remove-row').addEventListener('click', function(){ row.remove(); refresh(); });
    select.addEventListener('change', refresh);
    row.querySelector('.qty-input').addEventListener('input', refresh);
    container.appendChild(row);
    refresh();
  }
  function refresh(){
    var rows = container.querySelectorAll('.item-row');
    emptyMsg.style.display = rows.length ? 'none' : 'block';
    var subtotal = 0;
    var items = [];
    rows.forEach(function(row){
      var pid = Number(row.querySelector('.product-select').value);
      var qty = Math.max(1, Number(row.querySelector('.qty-input').value)||1);
      var priceLabel = row.querySelector('.price-label');
      var subLabel = row.querySelector('.subtotal-label');
      if(pid && productMap[pid]){
        var price = productMap[pid].priceCents;
        var sub = price * qty;
        priceLabel.textContent = brl(price);
        subLabel.textContent = brl(sub);
        subtotal += sub;
        items.push({productId: pid, quantity: qty});
      } else {
        priceLabel.textContent = '—';
        subLabel.textContent = '—';
      }
    });
    subtotalLabel.textContent = brl(subtotal);
    var discount = parseBRL(discountInput.value);
    var total = Math.max(0, subtotal - discount);
    totalLabel.textContent = brl(total);
    itemsJson.value = JSON.stringify(items);
    if(modalitySelect.value === 'ONCE' && Number(installmentsInput.value) !== 1){
      installmentsInput.setCustomValidity('Modalidade À vista exige exatamente 1 parcela');
    } else {
      installmentsInput.setCustomValidity('');
    }
  }
  document.getElementById('addItemBtn').addEventListener('click', createRow);
  discountInput.addEventListener('input', refresh);
  installmentsInput.addEventListener('input', refresh);
  modalitySelect.addEventListener('change', refresh);
  document.getElementById('saleForm').addEventListener('submit', function(e){
    refresh();
    var rows = container.querySelectorAll('.item-row');
    if(rows.length === 0){ e.preventDefault(); showToast('Adicione ao menos um produto','error'); return; }
    var hasInvalid = false;
    rows.forEach(function(row){
      if(!row.querySelector('.product-select').value) hasInvalid = true;
    });
    if(hasInvalid){ e.preventDefault(); showToast('Selecione o produto em todos os itens','error'); return; }
    var items = JSON.parse(itemsJson.value || '[]');
    if(items.length === 0){ e.preventDefault(); showToast('Adicione ao menos um produto','error'); }
  });
  if(products.length>0) createRow();
})();
</script>
