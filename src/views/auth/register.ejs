<div class="min-vh-100 d-flex align-items-center justify-content-center p-3" style="background:var(--mc-bg)">
  <div class="auth-card auth-card-wide">
    <div class="card-body p-4 p-md-5">
      <div class="text-center mb-4">
        <span class="d-inline-flex align-items-center justify-content-center mb-3" style="width:48px;height:48px;background:var(--mc-primary);color:#fff;border-radius:var(--mc-radius-lg)"><i class="bi bi-shop fs-4"></i></span>
        <h1 class="h4 fw-bold mb-1" style="letter-spacing:var(--mc-tracking-tight)">Criar sua conta</h1>
        <p class="small mb-0" style="color:var(--mc-text-muted)">Comece a vender em poucos segundos</p>
      </div>
      <%- include('../partials/_flash') %>
      <form action="/auth/register" method="POST" data-prevent-double novalidate>
        <div class="mb-3">
          <label for="tenantName" class="form-label">Nome do negócio</label>
          <input type="text" class="form-control" id="tenantName" name="tenantName" value="<%= typeof formData !== 'undefined' && formData ? formData.tenantName : '' %>" placeholder="Ex: Loja do João" required>
        </div>
        <div class="mb-3">
          <label for="name" class="form-label">Seu nome</label>
          <input type="text" class="form-control" id="name" name="name" value="<%= typeof formData !== 'undefined' && formData ? formData.name : '' %>" placeholder="Seu nome completo" required>
        </div>
        <div class="mb-3">
          <label for="email" class="form-label">E-mail</label>
          <input type="email" class="form-control" id="email" name="email" value="<%= typeof formData !== 'undefined' && formData ? formData.email : '' %>" placeholder="seu@email.com" required>
        </div>
        <div class="mb-4">
          <label for="password" class="form-label">Senha</label>
          <input type="password" class="form-control" id="password" name="password" placeholder="Mínimo 8 caracteres" required>
          <div class="form-text">Mínimo de 8 caracteres</div>
        </div>
        <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold">Criar conta</button>
      </form>
      <p class="text-center small mt-4 mb-0" style="color:var(--mc-text-muted)">Já tem conta? <a href="/auth/login" class="fw-semibold" style="color:var(--mc-text)">Entrar</a></p>
    </div>
  </div>
</div>
